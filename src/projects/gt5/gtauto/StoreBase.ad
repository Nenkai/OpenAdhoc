static category_id_ = [];
static gameitem_map_ = [ : ];
static code_map_ = [ : ];
static sNeedCapture = false;
static sRidingCar;

method open(context, category_id)
{
    category_id_ = category_id;
    gameitem_map_ = GameItemUtil::getTuneShopMap(category_id_);
    SequenceUtil::startPage(context, self);
}

method close(context)
{
    capture(context);
    SequenceUtil::startPage(context, StoreRoot);
}

method onInitialize(context)
{
    self.insensitive = true;
    ROOT::Count2::Count::haveCountText.text = 0;
    ROOT::sRidingCar = nil;
    ROOT::sRidingCar = GAME_STATUS.user_profile.garage.getRidingCar();

    initCodeMap();
    initPriceText();
    initFocus();

    ButtonHelpGT5.set(context, [
        [ButtonHelpGT5.getEnterButtonName(), context.translate(ROOT, "Component", "Enter")], 
        [ButtonHelpGT5.getCancelButtonName(), context.translate(ROOT, "Component", "Cancel")]
    ]);

    context.pushEvent(main::menu::MFunctionEvent(postInitialize, context));
}

method postInitialize(context)
{
    self.insensitive = false;
}

method onFinalize(context)
{
    code_map_ = nil;
    gameitem_map_ = nil;
    category_id_ = nil;
    ROOT::sRidingCar = nil;
    ROOT::sNeedCapture = false;
}

method onCancel(context)
{
    main::sound.play("cancel");
    ROOT.close(context);
    return EVENTRESULT_FILTER;
}

function GetMoneyString(num)
{
    var str = "";
    if (num == 0)
        str = "0";
    else
        str = main::pdiext::MMisc::GetMoneyString(num);

    return str;
}

function setMap(map_list)
{
    code_map_ = [ : ];
    for (var i = 0; i < map_list.size; i++)
        code_map_.insert([map_list[i][0] : map_list[i][1]]);
}

function getPriceText(item_code)
{
    var item = ROOT::gameitem_map_.find(item_code);
    return GetMoneyString(item[1]["price"]);
}

function openPurchasingPopup(context, event)
{
    main::sound.play("ok");

    var widget_name = event.widget.name;
    var item = ROOT::gameitem_map_.find(ROOT::code_map_.find(widget_name)[1]);
    var gameitem = GameItemUtil::getItemByID(item[1]["gameitem_id"]);
    var cp = GAME_STATUS.user_profile.garage.getRidingCar();
    var bonnet_check_flag = false;

    if (GameItemUtil::isBonnetItem(gameitem) && !GameItemUtil::isHavingParts(cp, gameitem))
        bonnet_check_flag = true;

    SettingProject::ItemDetailPopup.openByItem(context, gameitem, cp);
    ROOT::HeaderGT5::HBox::Credits.refresh();

    if (GameItemUtil::isBonnetItem(gameitem) && bonnet_check_flag && GameItemUtil::isHavingParts(cp, gameitem))
        sNeedCapture = true;

    checkPartsStatus(event.widget);

    return EVENTRESULT_FILTER;
}

function getItemCount(item_w)
{
    var widget_name = item_w.name;
    var item_code = code_map_.find(widget_name)[1];
    var count = GameItemUtil::ItemBox::getNumByCode(item_code);
    ROOT::Count2::Count::haveCountText.text = count;
}

function checkPartsStatus(item_w)
{
    var widget_name = item_w.name;
    var item_code = code_map_.find(widget_name)[1];
    var item = ROOT::gameitem_map_.find(ROOT::code_map_.find(widget_name)[1]);

    if (GameItemUtil::isHavingParts(ROOT::sRidingCar, item[1]))
        item_w.ItemStatus.image_path = "image/gt5/gtauto/shop/ItemStatus_check.dds";
    else if (!GameItemUtil::isExistsParts(ROOT::sRidingCar, item[1]))
        item_w.ItemStatus.image_path = "image/gt5/gtauto/shop/ItemStatus_non.dds";
}