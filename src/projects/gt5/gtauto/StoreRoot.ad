module StoreRoot::MyHome
{
    method onActivate(context)
    {
        sound.play("return");
        close(context);

        return EVENTRESULT_FILTER;
    }

    method onCancel(context)
    {
        sound.play("return");
        close(context);

        return EVENTRESULT_FILTER;
    }

    method onFocusEnter(context, event)
    {
        BalloonTip.set_value(context, event.widget, context.translate(StoreRoot, "MyHome", "MYHOME_BACK_BUTTON"), 20);

        return EVENTRESULT_STOP;
    }

    method onFocusLeave(context, event)
    {
        StoreRoot::BalloonTip.reset_value();
        return EVENTRESULT_STOP;
    }
}