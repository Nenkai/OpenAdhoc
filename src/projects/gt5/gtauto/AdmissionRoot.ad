module ROOT
{
    #include "StoreBase.ad"

    function initCodeMap()
    {
        setMap([
            ["in_manifold", "in_manifold_01"], 
            ["air_cleaner_01",    "air_cleaner_01"], 
            ["air_cleaner_02",    "air_cleaner_02"], 
        ]);
    }

    function initPriceText()
    {
        Admission::in_manifold::info::Cr::CrText.text = getPriceText(code_map_.find("in_manifold")[1]);
        Admission::air_cleaner_01::info::Cr::CrText.text = getPriceText(code_map_.find("air_cleaner_01")[1]);
        Admission::air_cleaner_02::info::Cr::CrText.text = getPriceText(code_map_.find("air_cleaner_02")[1]);

        checkPartsStatus(Admission::in_manifold);
        checkPartsStatus(Admission::air_cleaner_01);
        checkPartsStatus(Admission::air_cleaner_02);
    }

    function initFocus()
    {
        ROOT.setFocus(Admission::in_manifold);
    }

    function capture()
    {

    }

    module ROOT::Admission
    {
        method onActivate(context, event)
        {
            return openPurchasingPopup(context, event);
        }

        method onFocusEnter(context, event)
        {
            getItemCount(event.widget);
            ROOT::Count2::Count::haveCountText::FadeActor.start();

            return EVENTRESULT_CONTINUE;
        }

        method onFocusLeave(context, event)
        {
            ROOT::Count2::Count::haveCountText::FadeActor.reset();
            ROOT::Count2::Count::haveCountText.text = "";

            return EVENTRESULT_CONTINUE;
        }
    }
}