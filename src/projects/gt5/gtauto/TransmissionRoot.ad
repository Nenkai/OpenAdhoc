module ROOT
{
    #include "StoreBase.ad"

    function initCodeMap()
    {
        setMap([
            ["transmission_01", "transmission_01"], 
            ["transmission_02", "transmission_02"], 
            ["transmission_03", "transmission_03"]
        ]);
    }

    function initPriceText()
    {
        transmission_01::info::Cr::CrText.text = getPriceText(code_map_.find("transmission_01")[1]);
        transmission_02::info::Cr::CrText.text = getPriceText(code_map_.find("transmission_02")[1]);
        transmission_03::info::Cr::CrText.text = getPriceText(code_map_.find("transmission_03")[1]);

        checkPartsStatus(transmission_01);
        checkPartsStatus(transmission_02);
        checkPartsStatus(transmission_03);
    }

    function initFocus()
    {
        ROOT.setFocus(transmission_01);
    }

    function capture()
    {

    }

    module ROOT::transmission_01
    {
        method onActivate(context, event)
        {
            return openPurchasingPopup(context, event);
        }

        method onFocusEnter(context, event)
        {
            getItemCount(event.widget);
            ROOT::Count2::Count::haveCountText::FadeActor.start();

            return EVENTRESULT_CONTINUE;
        }

        method onFocusLeave(context, event)
        {
            ROOT::Count2::Count::haveCountText::FadeActor.reset();
            ROOT::Count2::Count::haveCountText.text = "";

            return EVENTRESULT_CONTINUE;
        }
    }

    module ROOT::transmission_02
    {
        method onActivate(context, event)
        {
            return openPurchasingPopup(context, event);
        }

        method onFocusEnter(context, event)
        {
            getItemCount(event.widget);
            ROOT::Count2::Count::haveCountText::FadeActor.start();

            return EVENTRESULT_CONTINUE;
        }

        method onFocusLeave(context, event)
        {
            ROOT::Count2::Count::haveCountText::FadeActor.reset();
            ROOT::Count2::Count::haveCountText.text = "";

            return EVENTRESULT_CONTINUE;
        }
    }

    module ROOT::transmission_03
    {
        method onActivate(context, event)
        {
            return openPurchasingPopup(context, event);
        }

        method onFocusEnter(context, event)
        {
            getItemCount(event.widget);
            ROOT::Count2::Count::haveCountText::FadeActor.start();

            return EVENTRESULT_CONTINUE;
        }

        method onFocusLeave(context, event)
        {
            ROOT::Count2::Count::haveCountText::FadeActor.reset();
            ROOT::Count2::Count::haveCountText.text = "";

            return EVENTRESULT_CONTINUE;
        }
    }
}