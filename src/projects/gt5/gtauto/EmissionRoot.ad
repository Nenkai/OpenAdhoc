module ROOT
{
    #include "StoreBase.ad"

    function initCodeMap()
    {
        setMap(
        [
            // widget name     item
            ["ExManifold_01",  "ex_manifold_01"], 
            ["muffler_01",     "muffler_01"], 
            ["muffler_02",     "muffler_02"], 
            ["muffler_03",     "muffler_03"], 
            ["Catalyst_01",    "catalyst_01"]
        ]);
    }

    function initPriceText()
    {
        intake_catalyst::ExManifold_01::info::Cr::CrText.text = getPriceText(code_map_.find("ExManifold_01")[1]);
        muffler::muffler_01::info::Cr::CrText.text = getPriceText(code_map_.find("muffler_01")[1]);
        muffler::muffler_02::info::Cr::CrText.text = getPriceText(code_map_.find("muffler_02")[1]);
        muffler::muffler_03::info::Cr::CrText.text = getPriceText(code_map_.find("muffler_03")[1]);
        intake_catalyst::Catalyst_01::info::Cr::CrText.text = getPriceText(code_map_.find("Catalyst_01")[1]);

        checkPartsStatus(intake_catalyst::ExManifold_01);
        checkPartsStatus(muffler::muffler_01);
        checkPartsStatus(muffler::muffler_02);
        checkPartsStatus(muffler::muffler_03);
        checkPartsStatus(intake_catalyst::Catalyst_01);
    }

    function initFocus()
    {
        ROOT.setFocus(muffler::muffler_01);
    }

    function capture()
    {

    }

    module ROOT::muffler
    {
        method onActivate(context, event)
        {
            return openPurchasingPopup(context, event);
        }

        method onFocusEnter(context, event)
        {
            getItemCount(event.widget);
            ROOT::Count2::Count::haveCountText::FadeActor.start();

            return EVENTRESULT_CONTINUE;
        }

        method onFocusLeave(context, event)
        {
            ROOT::Count2::Count::haveCountText::FadeActor.reset();
            ROOT::Count2::Count::haveCountText.text = "";

            return EVENTRESULT_CONTINUE;
        }
    }

    module ROOT::intake_catalyst
    {
        method onActivate(context, event)
        {
            return openPurchasingPopup(context, event);
        }

        method onFocusEnter(context, event)
        {
            getItemCount(event.widget);
            ROOT::Count2::Count::haveCountText::FadeActor.start();

            return EVENTRESULT_CONTINUE;
        }

        method onFocusLeave(context, event)
        {
            ROOT::Count2::Count::haveCountText::FadeActor.reset();
            ROOT::Count2::Count::haveCountText.text = "";

            return EVENTRESULT_CONTINUE;
        }
    }
}