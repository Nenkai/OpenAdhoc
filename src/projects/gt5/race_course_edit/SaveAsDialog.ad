module ROOT
{
    attribute popup;
    attribute closed = false;
    attribute popup_title;
    attribute title;
    attribute result;

    method open(context, popup_title, title)
    {
        self.result = nil;
        self.popup_title = popup_title;
        self.title = title;
        self.closed = false;
        self.popup = main::SequenceUtil::ModalPage(context, ROOT);
        self.popup.open();

        return self.result;
    }

    method close(context)
    {
        if (self.closed)
            return;

        self.closed = true;

        FadeActor.on_effect_end = function (context) 
        {
            if (ROOT.popup != nil)
            {
                ROOT.popup.close();
                ROOT.popup = nil;
            }
        };

        self.FadeActor.out = true;
    }

    method onInitialize(context)
    {
        self.Popup.Pane.TitleRow.label.text = self.popup_title;
    }

    method onFinalize(context)
    {
        self.popup = nil;
        self.closed = nil;
        self.popup_title = nil;
        self.title = nil;
    }

    method onCancel(context)
    {
        main::sound.play("cancel");
        ROOT.setFocus(Popup::Pane::FootRow::CancelOK::Cancel);
        return EVENTRESULT_FILTER;
    }

    module Popup::Pane
    {
        SCALE_WIDGET_SDTV(TitleRow::label, 2.6);

        module Body
        {
            SCALE_WIDGET_SDTV(TextFaceLarge, 2.6);

            method onInitialize(context)
            {
                var msg = context.translate(ROOT, "MESSAGE");
                var num = context.translate(ROOT, "MyHome", "WITHIN_N_LETTERS").build(24);
                self.TextFaceLarge.text = "%{msg} %{num}";
            }

            module InputText::InputTextFace
            {
                method onInitialize(context)
                {
                    self.value = ROOT.title;
                    ROOT.setFocus(self);
                }
            }
        }

        module FootRow
        {
            module CancelOK
            {
                module Cancel
                {
                    method onActivate(context)
                    {
                        main::sound.play("ok");
                        ROOT.close(context);

                        return EVENTRESULT_FILTER;
                    }

                    method onCancel(context)
                    {
                        main::sound.play("cancel");
                        ROOT.close(context);

                        return EVENTRESULT_FILTER;
                    }
                }

                module OK
                {
                    method onActivate(context)
                    {
                        main::sound.play("ok");

                        var name = Popup::Pane::Body::InputText::InputTextFace.value;
                        var save_preview = Popup::Pane::FootRow::SavePreview::CheckBox.active;

                        if (name == nil || name.size == 0)
                        {
                            var text = context.translate(ROOT, "MESSAGE");
                            DialogUtil::openConfirmDialog(context, DialogUtil::ERROR, text);
                            return EVENTRESULT_FILTER;
                        }

                        ROOT.result = ["title" : name, "save_preview" : save_preview];

                        ROOT.close(context);
                        return EVENTRESULT_FILTER;
                    }
                }
            }

            module SavePreview
            {
                method onInitialize(context)
                {
                    self.visible = GetVersionBranch() == "runviewer";
                }
            }
        }
    }
}