module ROOT
{
    #include "StoreBase.ad"

    function initCodeMap()
    {
        setMap([
            ["turbo1", "turbo_01"], 
            ["turbo2", "turbo_02"], 
            ["turbo3", "turbo_03"], 
            ["SuperCharger", "super_charger_01"]
        ]);
    }

    function initPriceText()
    {
        Booster::turbo1::Cr::CrText.text = getPriceText(code_map_.find("turbo1")[1]);
        Booster::turbo2::Cr::CrText.text = getPriceText(code_map_.find("turbo2")[1]);
        Booster::turbo3::Cr::CrText.text = getPriceText(code_map_.find("turbo3")[1]);
        SuperCharger::info::Cr::CrText.text = getPriceText(code_map_.find("SuperCharger")[1]);

        checkPartsStatus(Booster::turbo1);
        checkPartsStatus(Booster::turbo2);
        checkPartsStatus(Booster::turbo3);
        checkPartsStatus(SuperCharger);
    }

    function initFocus()
    {
        ROOT.setFocus(Booster::turbo1);
    }

    function capture()
    {

    }

    module ROOT::Booster
    {
        method onActivate(context, event)
        {
            return openPurchasingPopup(context, event);
        }

        method onFocusEnter(context, event)
        {
            getItemCount(event.widget);
            ROOT::Count2::Count::haveCountText::FadeActor.start();

            return EVENTRESULT_CONTINUE;
        }

        method onFocusLeave(context, event)
        {
            ROOT::Count2::Count::haveCountText::FadeActor.reset();
            ROOT::Count2::Count::haveCountText.text = "";

            return EVENTRESULT_CONTINUE;
        }
    }

    module ROOT::SuperCharger
    {
        method onActivate(context, event)
        {
            return openPurchasingPopup(context, event);
        }

        method onFocusEnter(context, event)
        {
            getItemCount(event.widget);
            ROOT::Count2::Count::haveCountText::FadeActor.start();

            return EVENTRESULT_CONTINUE;
        }

        method onFocusLeave(context, event)
        {
            ROOT::Count2::Count::haveCountText::FadeActor.reset();
            ROOT::Count2::Count::haveCountText.text = "";

            return EVENTRESULT_CONTINUE;
        }
    }
}