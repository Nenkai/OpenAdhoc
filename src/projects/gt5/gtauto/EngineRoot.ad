module ROOT
{
    #include "StoreBase.ad"

    function initCodeMap()
    {
        setMap([
            ["Computer", "computer_01"], 
            ["na_01",    "na_01"], 
            ["na_02",    "na_02"], 
            ["na_03",    "na_03"]
        ]);
    }

    function initPriceText()
    {
        Computer::info::Cr::CrText.text = getPriceText(code_map_.find("Computer")[1]);
        Engine::na_01::Cr::CrText.text = getPriceText(code_map_.find("na_01")[1]);
        Engine::na_02::Cr::CrText.text = getPriceText(code_map_.find("na_02")[1]);
        Engine::na_03::Cr::CrText.text = getPriceText(code_map_.find("na_03")[1]);

        checkPartsStatus(Computer);
        checkPartsStatus(Engine::na_01);
        checkPartsStatus(Engine::na_02);
        checkPartsStatus(Engine::na_03);
    }

    function initFocus()
    {
        ROOT.setFocus(Engine::na_01);
    }

    function capture()
    {

    }

    module ROOT::Computer
    {
        method onActivate(context, event)
        {
            return openPurchasingPopup(context, event);
        }

        method onFocusEnter(context, event)
        {
            getItemCount(event.widget);
            ROOT::Count2::Count::haveCountText::FadeActor.start();

            return EVENTRESULT_CONTINUE;
        }

        method onFocusLeave(context, event)
        {
            ROOT::Count2::Count::haveCountText::FadeActor.reset();
            ROOT::Count2::Count::haveCountText.text = "";

            return EVENTRESULT_CONTINUE;
        }
    }

    module ROOT::Engine
    {
        method onActivate(context, event)
        {
            return openPurchasingPopup(context, event);
        }
        
        method onFocusEnter(context, event)
        {
            getItemCount(event.widget);
            ROOT::Count2::Count::haveCountText::FadeActor.start();

            return EVENTRESULT_CONTINUE;
        }

        method onFocusLeave(context, event)
        {
            ROOT::Count2::Count::haveCountText::FadeActor.reset();
            ROOT::Count2::Count::haveCountText.text = "";

            return EVENTRESULT_CONTINUE;
        }
    }
}