#include "parts_list.ad"

function getPartsShopName(type, cat)
{
	if (type < 32)
		return getPartsName(type, cat);
	else
	{
		switch (type)
		{
			case 32:
				return "STIFFNESS_REFRESH";
				break;
			default:
				return "getPartsShopName ERROR";
		}
	}
}