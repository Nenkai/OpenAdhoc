module ROOT
{
    hidden.visible = false;

    function GetLoadingBgFileName(info)
    {
        return "piece/loading_bg/%{info.loading_bg}.img";
    }

    function onRealize()
    {
        class LicenseData : System::Object
        {
            attribute gp;
            attribute title;
            attribute caption;
            attribute prize_table;
            attribute eval_condition_type;
            attribute eval_condition_data;

            method __init__(gp, title, caption, prize_table, eval_condition_type, eval_condition_data)
            {
                self.gp = gp;
                self.title = title;
                self.caption = caption;

                self.prize_table = prize_table != nil ? prize_table : [];
                self.eval_condition_type = eval_condition_type != nil ? eval_condition_type : 0;
                self.eval_condition_data = eval_condition_data != nil ? eval_condition_data : [];
            }
        }

        class EventRaceData : System::Object
        {
            attribute gp;
            attribute caption;

            method __init__(gp, caption)
            {
                self.gp = gp;
                self.caption = caption;
            }
        }

        class SpecialEventData : System::Object
        {
            attribute gp;
            attribute logo_image_path;
            attribute caption;
            attribute caption_i18n;

            method __init__(gp, logo_image_path, caption, caption_i18n)
            {
                self.gp = gp;
                self.logo_image_path = logo_image_path;
                self.caption = caption;
                self.caption_i18n = caption_i18n;
            }
        }

        class EditCourseData : System::Object
        {
            attribute gp;
            attribute caption;

            method __init__(gp, caption)
            {
                self.gp = gp;
                self.caption = caption;
            }
        }

        class WarningTextData : System::Object
        {
            attribute text;
            attribute seconds;
            attribute start_time;

            method __init__(text, seconds)
            {
                self.text = text;
                self.seconds = seconds;
            }
        }

        class AcademyData : System::Object
        {
            attribute round;
            attribute title;
            attribute caption;

            method __init__(round, title, caption)
            {
                self.round = round;
                self.title = title;
                self.caption = caption;
            }
        }
    }

    static sData

    function setData(data)
    {
        sData = data;
    }

    method setup_entry_common(context, entry_list)
    {
        var space = NormalFrame::Head::space;
        space.visible = entry_list.size > 1;
        if (!space.visible)
            return;

        var offset = 0.0;
        for (var i = 0; i < entry_list.size; i++)
        {
            var item = hidden::Entry.doCopy();
            item.x = offset;
            item.y = 0.0;
            space.appendChild(context, item);
            offset += item.w;

            var entry = entry_list[i];
            item.Grid.label.text = "%d".format(entry.slot_id + 1);
            item.Grid.Chip.color.setCarParameter(entry.cp);
            item.Driver.text = entry.driver_name;
            item.DriverA.text = item.Driver.text;
            item.Car.text = gtengine::MSpecDB::getCarName(entry.car_code);
            item.CarA.text = item.Car.text;

            item.Grid.active = entry.is_target;
            item.active = entry.is_target;
        }

        space.w = 0.0 + offset;
        space.x = 0.0;

        if (space.w > menu::ScreenWidth)
        {
            space.ScalarInterpolator.start_value = menu::ScreenWidth;
            space.ScalarInterpolator.end_value = -space.w;
            space.ScalarInterpolator.total_time = ((menu
                ::ScreenWidth + space.w) / menu::ScreenWidth) * 8.0;
        }

        else
        {
            space.x = (menu
                ::ScreenWidth - space.w) * 0.5;

            space.ScalarInterpolator.stop();
        }
    }

    method get_info_with_replay_info(replay_info)
    {
        var result = [];
        for (var i = 0; i < replay_info.entry_num; i++)
        {
            var cp = replay_info.getCarParameter(i);
            var dp = replay_info.getDriverParameter(i);

            if (cp == nil || dp == nil)
                continue;

            var entry_info = EntryInfo();
            entry_info.slot_id = i;
            entry_info.is_target = cp.target;
            entry_info.car_code = cp.getCarCode();
            entry_info.car_color = cp.color;
            entry_info.driver_name = dp.display_name;
            entry_info.cp = cp;

            result.push(entry_info);
        }

        return result;
    }

    method get_info_with_race_operator()
    {
        var result = [];
        var registered_cp_list = RaceOperator.getAccountFixedCarParameterList();

        for (var i = 0; i < registered_cp_list.size; i++)
        {
            var cp = registered_cp_list[i];
            var dp = RaceOperator.getAccountDriverParameter(i, 0);

            if (cp == nil || dp == nil)
                continue;

            var entry_info = EntryInfo();
            entry_info.slot_id = i;
            entry_info.is_target = cp.target;
            entry_info.car_code = cp.getCarCode();
            entry_info.car_color = cp.color;
            entry_info.driver_name = dp.display_name;
            entry_info.cp = cp;

            result.push(entry_info);
        }

        return result;
    }

    method setup_entry_with_replay_info(context, replay_info)
    {
        var entry_list = get_info_with_replay_info(replay_info);
        setup_entry_common(context, entry_list);
    }

    method setup_entry(context)
    {
        var entry_list = get_info_with_race_operator();
        setup_entry_common(context, entry_list);
    }

    class EntryInfo : System::Object
    {
        attribute slot_id;
        attribute is_target;
        attribute car_code;
        attribute car_color;
        attribute driver_name;
        attribute cp;
    }

    method onInitialize(context)
    {
        menu::FrameInterval = 1;
        clear(context);

        NormalFrame.visible = true;
        Progress.visible = true;
        WarningText.visible = false;

        NormalFrame::Body::CourseInfo.visible = false;
        NormalFrame::Body::EventRaceInfo.visible = false;
        NormalFrame::Body::LicenseInfo.visible = false;
        NormalFrame::Body::EditCourseInfo.visible = false;
        NormalFrame::Body::AcademyInfo.visible = false;

        NormalFrame::Head::AcademyLogo.visible = false;
        NormalFrame::Head::bg.visible = true;
        NormalFrame::bg::bg.visible = true;
        NormalFrame::bg::Academy.visible = false;
        NormalFrame::footer::ColorFace.visible = true;

        var progress = pdistd::MProgress();
        progress.constant_progress_speed = 1.0 / 90.0;
        Progress::bar.progress = progress;
        Progress::bar.linear_mode = true;

        var is_display_entry = true;
        var is_display_info = true;
        var frame_info_w = NormalFrame::Body::CourseInfo;
        var replay_info = nil;
        var mode_timeattack = false;
        var gp;
        var rp;

        if (RaceOperator.isReplayMode())
        {
            var buf = ORG.getReplayHeaderFromWorkPath();
            if (buf != nil)
            {
                replay_info = gtengine::MReplayInfo();
                var success = replay_info.initialize(buf);

                if (!success)
                    replay_info = nil;
            }
        }

        if (replay_info != nil)
        {
            if (replay_info.entry_num == 1 || replay_info.onelap)
                mode_timeattack = true;
            if (mode_timeattack)
                is_display_entry = false;

            gp = replay_info.getGameParameter();
            rp = replay_info.getRaceParameter();

            if (gp.event.game_mode == gtengine::GameMode::EVENT_RALLY)
            {
                sData = nil;
                sData = EventRaceData(gp, gp.event.track.course_generator_param.course_name);
            }
        }
        else
        {
            if (sData != nil && sData.class_id.defined('gp') && sData.gp != nil)
            {
                gp = sData.gp;
                rp = sData.gp.event.race_parameter;
            }
            else
            {
                gp = RaceOperator.game_parameter;
                rp = RaceOperator.race_parameter;
            }
        }

        var course_code = rp.course_code;
        if (course_code == gtengine::MSpecDB::NO_CODE64)
            course_code = gp.event.track.course_code;

        switch (gp.event.game_mode)
        {
            case gtengine::GameMode::RACE_EDIT:
            case gtengine::GameMode::COURSE_EDIT:
            case gtengine::GameMode::ONLINE_ROOM:
                is_display_entry = false;
                is_display_info = false;
                frame_info_w = nil;
                break;

            case gtengine::GameMode::LICENSE:
                is_display_entry = false;
                is_display_info = true;
                frame_info_w = NormalFrame::Body::CourseInfo;
                break;

            case gtengine::GameMode::EVENT_RACE:
            case gtengine::GameMode::EVENT_RALLY:
                is_display_entry = true;
                is_display_info = true;
                frame_info_w = NormalFrame::Body::CourseInfo;
                break;

            case gtengine::GameMode::TIME_ATTACK:
            case gtengine::GameMode::DRIFT_ATTACK:
            case gtengine::GameMode::ONLINE_TIME_ATTACK:
                mode_timeattack = true;
                is_display_entry = false;
                is_display_info = true;
                frame_info_w = NormalFrame::Body::CourseInfo;
                break;

            default:
                ;
        }

        if (sData != nil)
        {
            if (sData.isInstanceOf(LicenseData))
                frame_info_w = NormalFrame::Body::LicenseInfo;
            else if (sData.isInstanceOf(EventRaceData))
                frame_info_w = NormalFrame::Body::EventRaceInfo;
            else if (sData.isInstanceOf(SpecialEventData))
                frame_info_w = NormalFrame::Body::SpecialEventInfo;
            else if (sData.isInstanceOf(EditCourseData))
                frame_info_w = NormalFrame::Body::EditCourseInfo;
            else if (sData.isInstanceOf(AcademyData))
                frame_info_w = NormalFrame::Body::AcademyInfo;
            else if (sData.isInstanceOf(WarningTextData))
            {
                is_display_entry = false;
                is_display_info = false;

                NormalFrame.visible = false;
                Progress.visible = false;
                WarningText.visible = true;
                WarningText::TextFace.text = sData.text;
                sData.start_time = pdistd::GetSystemTimeMicroSecond();
            }
        }

        if (is_display_info)
        {
            var info = CourseData::getCourseInfo(course_code);
            var image_name = GetLoadingBgFileName(info);

            if (frame_info_w == NormalFrame::Body::CourseInfo)
            {
                if (frame_info_w.CourseLogo.class_id.defined('memory_place'))
                    frame_info_w.CourseLogo.memory_place = "backward";

                frame_info_w.CourseLogo.image_path = "piece/course_logo_L/%{info.logo}.img";
                var course_name;
                var course_name_i18n;

                if (info.name == "")
                {
                    var course_label = gtengine::MSpecDB::getCourseLabel(course_code);
                    course_name = course_label;
                    course_name_i18n = course_label;
                }
                else
                {
                    var cursor_project = context.getCursorProject();
                    course_name = context.translate(cursor_project, "CourseName", info.name);
                    course_name_i18n = context.translate(cursor_project, "CourseNameI18n", info.name);
                }

                frame_info_w.CourseEng.text = course_name_i18n;
                frame_info_w.Course.text = course_name;
                frame_info_w.visible = true;
            }

            else if (frame_info_w == NormalFrame::Body::LicenseInfo)
            {
                var info = CourseData::getCourseInfo(course_code);

                if (frame_info_w.CourseLogo.class_id.defined('memory_place'))
                    frame_info_w.CourseLogo.memory_place = "backward";

                frame_info_w.CourseLogo.image_path = "piece/course_logo_L/%{info.logo}.img";
                frame_info_w.Title.text = sData.title;
                frame_info_w.Caption.text = sData.caption;
                frame_info_w.visible = true;
            }

            else if (frame_info_w == NormalFrame::Body::EventRaceInfo)
            {
                var info = CourseData::getCourseInfo(course_code);

                if (frame_info_w.CourseLogo.class_id.defined('memory_place'))
                    frame_info_w.CourseLogo.memory_place = "backward";

                frame_info_w.CourseLogo.image_path = "piece/course_logo_L/%{info.logo}.img";
                var course_name;
                var course_name_i18n;

                if (info.name == "")
                {
                    var course_label = gtengine::MSpecDB::getCourseLabel(course_code);
                    course_name = course_label;
                    course_name_i18n = course_label;
                }
                else
                {
                    var cursor_project = context.getCursorProject();
                    course_name = context.translate(cursor_project, "CourseName", info.name);
                    course_name_i18n = context.translate(cursor_project, "CourseNameI18n", info.name);
                }

                frame_info_w.CourseEng.text = course_name_i18n;
                frame_info_w.Caption.text = sData.caption;
                frame_info_w.visible = true;
            }

            else if (frame_info_w == NormalFrame::Body::SpecialEventInfo)
            {
                if (frame_info_w.Logo.class_id.defined('memory_place'))
                    frame_info_w.Logo.memory_place = "backward";

                frame_info_w.Logo.image_path = sData.logo_image_path;
                frame_info_w.Caption.text = sData.caption;
                frame_info_w.CaptionEng.text = sData.caption_i18n;
                frame_info_w.visible = true;
            }

            else if (frame_info_w == NormalFrame::Body::EditCourseInfo)
            {
                var course_label = gtengine::MSpecDB::getCourseLabel(course_code);

                if (frame_info_w.CourseLogo.class_id.defined('memory_place'))
                    frame_info_w.CourseLogo.memory_place = "backward";

                frame_info_w.CourseLogo.image_path = "piece/course_maker/cm_thumb_%{course_label}.img";
                frame_info_w.Caption.text = sData.caption;
                frame_info_w.visible = true;
            }

            else if (frame_info_w == NormalFrame::Body::AcademyInfo)
            {
                var image_face = NormalFrame::bg::Academy::ImageFace;
                if (image_face.class_id.defined('memory_place'))
                    image_face.memory_place = "backward";

                image_face.image_path = "piece/academy/bg_00.img";

                NormalFrame::Head::bg.visible = false;
                NormalFrame::footer::ColorFace.visible = false;
                NormalFrame::bg::bg.visible = false;
                NormalFrame::bg::Academy.visible = true;
                NormalFrame::Head::AcademyLogo.visible = true;

                frame_info_w.HBox::Round.text = sData.round;
                frame_info_w.HBox::Title.text = sData.title;
                frame_info_w.Caption.text = sData.caption;
                frame_info_w.visible = true;

                var academy_text = "";
                if (sData.title == "8-5")
                {
                    var country = PDINetwork.getRegionName();
                    var level = Grim2.getServerOptionToInt("gtacademy", "level.%{country}");
                    academy_text = Grim2.getServerOption("gtacademy", "round8.loading_%{level}");
                }

                frame_info_w.Academy.text = academy_text;
                frame_info_w.Academy.visible = academy_text != "";
            }

            if (GetVersionBranch() != "academy")
                ORG.setLoadingImageFile(image_name);
        }

        if (is_display_entry)
        {
            if (replay_info != nil)
                setup_entry_with_replay_info(context, replay_info, mode_timeattack);
            else
                setup_entry(context, mode_timeattack);
        }
    }

    method onFinalize(context)
    {
        clear(context);
        sData = nil;
    }

    method onCancel(context)
    {
        return EVENTRESULT_FILTER;
    }

    method onPageOutEnd(context)
    {
        ORG.applySimulView(5);
    }

    method onPageInStart(context)
    {
        if (sData == nil || !sData.isInstanceOf(WarningTextData))
            return;

        var end_time = sData.start_time + (sData.seconds.toLong() * 1000000L);

        while (true)
        {
            var t2 = pdistd::GetSystemTimeMicroSecond();
            if (t2 >= end_time)
                break;

            pdistd::DelayThread(10000);
        }
    }

    method onPageOutStart(context)
    {

    }

    method clear(context)
    {
        NormalFrame::Head::space.clearWindow(context);

        {
            var w = NormalFrame::Body::CourseInfo;
            w.CourseLogo.image_path = "";
            w.CourseEng.text = nil;
            w.Course.text = nil;
        }
        {
            var w = NormalFrame::Body::LicenseInfo;
            w.CourseLogo.image_path = "";
            w.Title.text = nil;
            w.Caption.text = nil;
        }
        {
            var w = NormalFrame::Body::EventRaceInfo;
            w.CourseLogo.image_path = "";
            w.Caption.text = nil;
        }
        {
            var w = NormalFrame::Body::SpecialEventInfo;
            w.Logo.image_path = "";
            w.Caption.text = nil;
            w.CaptionEng.text = nil;
        }
        {
            var w = NormalFrame::Body::EditCourseInfo;
            w.CourseLogo.image_path = "";
            w.Caption.text = nil;
        }
        {
            var w = NormalFrame::Body::AcademyInfo;
            w.HBox::Round.text = nil;
            w.HBox::Title.text = nil;
            w.Caption.text = nil;
            w.Academy.text = nil;
            NormalFrame::bg::Academy::ImageFace.image_path = "";
        }

        WarningText::TextFace.text = nil;
    }
}