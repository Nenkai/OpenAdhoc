module ROOT
{
    #include "StoreBase.ad"

    function initCodeMap()
    {
        setMap(
        [
            // widget name    item
            ["Rain01Text",    "tire___12"], 
            ["Rain02Text",    "tire___13"], 
            ["Dirt01Text",    "tire___14"], 
            ["Snow01Text",    "tire___15"]
        ]);
    }

    function initPriceText()
    {
        STire::Rain01CrText.text = ROOT::getPriceText(STireRoot::code_map_.find("Rain01Text")[1]);
        STire::Rain02CrText.text = ROOT::getPriceText(STireRoot::code_map_.find("Rain02Text")[1]);
        STire::Dirt01CrText.text = ROOT::getPriceText(STireRoot::code_map_.find("Dirt01Text")[1]);
        STire::Snow01CrText.text = ROOT::getPriceText(STireRoot::code_map_.find("Snow01Text")[1]);
    }

    function initFocus()
    {
        ROOT.setFocus(STire::Dirt01Text);
    }

    function capture()
    {

    }

    module ROOT::STire
    {
        method onActivate(context, event)
        {
            return openPurchasingPopup(context, event);
        }

        method onFocusEnter(context, event)
        {
            getItemCount(event.widget);

            return EVENTRESULT_CONTINUE;
        }

        method onFocusLeave(context, event)
        {
            ROOT::Count2::Count::haveCountText.text = 0;

            return EVENTRESULT_CONTINUE;
        }
    }
}