module ROOT
{
    #include "StoreBase.ad"

    function initCodeMap()
    {
        setMap(
        [
            // widget name     item
            ["suspension_01",  "suspension_01"], 
            ["suspension_02",  "suspension_02"], 
            ["suspension_03",  "suspension_03"]
        ]);
    }

    function initPriceText()
    {
        suspension_01::info::Cr::CrText.text = getPriceText(code_map_.find("suspension_01")[1]);
        suspension_02::info::Cr::CrText.text = getPriceText(code_map_.find("suspension_02")[1]);
        suspension_03::info::Cr::CrText.text = getPriceText(code_map_.find("suspension_03")[1]);

        checkPartsStatus(suspension_01);
        checkPartsStatus(suspension_02);
        checkPartsStatus(suspension_03);
    }

    function initFocus()
    {
        ROOT.setFocus(suspension_01);
    }

    function capture()
    {

    }

    module ROOT::suspension_01
    {
        method onActivate(context, event)
        {
            return openPurchasingPopup(context, event);
        }

        method onFocusEnter(context, event)
        {
            getItemCount(event.widget);
            ROOT::Count2::Count::haveCountText::FadeActor.start();

            return EVENTRESULT_CONTINUE;
        }

        method onFocusLeave(context, event)
        {
            ROOT::Count2::Count::haveCountText::FadeActor.reset();
            ROOT::Count2::Count::haveCountText.text = "";

            return EVENTRESULT_CONTINUE;
        }
    }

    module ROOT::suspension_02
    {
        method onActivate(context, event)
        {
            return openPurchasingPopup(context, event);
        }

        method onFocusEnter(context, event)
        {
            getItemCount(event.widget);
            ROOT::Count2::Count::haveCountText::FadeActor.start();

            return EVENTRESULT_CONTINUE;
        }

        method onFocusLeave(context, event)
        {
            ROOT::Count2::Count::haveCountText::FadeActor.reset();
            ROOT::Count2::Count::haveCountText.text = "";

            return EVENTRESULT_CONTINUE;
        }
    }

    module ROOT::suspension_03
    {
        method onActivate(context, event)
        {
            return openPurchasingPopup(context, event);
        }

        method onFocusEnter(context, event)
        {
            getItemCount(event.widget);
            ROOT::Count2::Count::haveCountText::FadeActor.start();

            return EVENTRESULT_CONTINUE;
        }

        method onFocusLeave(context, event)
        {
            ROOT::Count2::Count::haveCountText::FadeActor.reset();
            ROOT::Count2::Count::haveCountText.text = "";

            return EVENTRESULT_CONTINUE;
        }
    }
}