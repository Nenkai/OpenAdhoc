module PROJECT::ROOT
{
    function setIcon(context, name)
    {
        if (name == nil)
            name = "cursor";

        var image_path = "image/cursor/" + name + ".png";
        if (Cursor.image_path != image_path)
        {
            Cursor.image_path = image_path;
            Cursor.doInitialize(context);
        }
    }
}