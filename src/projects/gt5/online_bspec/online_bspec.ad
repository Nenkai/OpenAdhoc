module PROJECT
{
    PROJECT.load("/scripts/gt5/util/gtmode_pack");

    static additional_projects;

    function onLoad(update_context)
    {
        update_context.createRenderContext(1);
        var render_context = update_context.getRenderContext(0);

        {
            ProjectHistoryUtil::DefineVariables(PROJECT, [
            ['waiting_mode', false]]);
        }

        SequenceUtil::setPageTransition(["*,*" : CursorProject::GTLogoTransition]);

        loadProjects();
        OnlineBSpecRoot.open(render_context);
    }

    function onUnload(update_context)
    {
        unloadProjects();
    }

    function resetActors(widget, reverse, warp)
    {
        for (var current_widget = widget.first_actor; current_widget != nil; current_widget = current_widget.next_actor)
        {
            if (current_widget.isInstanceOf(main::menu::MActor))
            {
                current_widget.stop();
                current_widget.reverse = reverse;
                if (warp)
                    current_widget.reverse = !reverse;

                current_widget.rewind();
                current_widget.start();
            }
        }
    }

    function startActors(widget, reverse)
    {
        for (var current_widget = widget.first_actor; current_widget != nil; current_widget = current_widget.next_actor)
        {
            if (current_widget.isInstanceOf(main::menu::MActor))
            {
                current_widget.stop();
                current_widget.reverse = reverse;
                current_widget.start();
            }
        }
    }

    function loadManualProject(context)
    {
        if (!__projects__.defined("ManualProject"))
        {
            var project_name = "manual";
            var project = main::manager.loadProject("%{main::PROJECT_ROOT_DIR}/%{project_name}/%{project_name}");
            additional_projects.push(project);
        }
    }

    function loadProjects()
    {
        additional_projects = Array();

        foreach (var project_name in ["user_profile"])
        {
            var project = main::manager.loadProject("%{main::PROJECT_ROOT_DIR}/%{project_name}/%{project_name}");
            additional_projects.push(project);
        }
    }

    function unloadProjects()
    {
        foreach (var project in additional_projects)
            main::manager.unloadProject(project);

        additional_projects = nil;
    }

    function OK(context, root, msg)
    {
        DialogUtil::openConfirmDialog(context, DialogUtil::OK, context.translate(root, "RemoteRace", msg));
    }

    function ERROR(context, root, msg)
    {
        DialogUtil::openConfirmDialog(context, DialogUtil::ERROR, context.translate(root, "RemoteRace", msg));
    }

    function ERROR1(context, root, msg, args)
    {
        DialogUtil::openConfirmDialog(context, DialogUtil::ERROR, context.translate(root, "RemoteRace", msg).build(args));
    }

    function QUERY(context, root, msg)
    {
        return DialogUtil::openConfirmDialog(context, DialogUtil::YESNO, context.translate(root, "RemoteRace", msg));
    }

    function copyReward(src_gp, dst_gp)
    {
        var src_reward = src_gp.event.reward;
        var dst_reward = dst_gp.event.reward;
        dst_reward.special_reward_code = src_reward.special_reward_code;
        dst_reward.prize_type = src_reward.prize_type;

        {
            for (var i = 0; i < src_reward.prize_table.size; ++i)
                dst_reward.prize_table[i] = src_reward.prize_table[i];
        }

        {
            for (var i = 0; i < src_reward.point_table.size; ++i)
                dst_reward.point_table[i] = src_reward.point_table[i];
        }

        {
            for (var i = 0; i < src_reward.present.size; ++i)
                dst_reward.present[i] = src_reward.present[i];
        }
    }

    function startRemoteRace(context, gp0, driver_list, auto_save, plan_id)
    {
        var course_info = CourseData::getCourseInfo(gp0.event.track.course_code);
        GAME_STATUS.user_profile.context.clearOnlineBSpec();

        if (plan_id != nil)
            GAME_STATUS.user_profile.context.online_bspec.plan_id = plan_id;

        var dp_list = [];
        var user_id_list = [];
        var driver_index_list = Array(driver_list.size);

        {
            for (var i = 0; i < driver_list.size; ++i)
                driver_index_list[i] = i;
        }

        driver_index_list.randomShuffle(pdistd::GetSystemTimeMicroSecond());
        var index = 0;
        {
            for (var i = 0; i < driver_list.size; ++i)
            {
                var driver = driver_list[driver_index_list[i]];
                dp_list.push(driver["dp"]);

                GAME_STATUS.user_profile.context.online_bspec.driver_id_list[index] = driver["driver_id"];
                GAME_STATUS.user_profile.context.online_bspec.user_list[index] = driver["user_id"];
                user_id_list.push(driver["user_id"]);

                GAME_STATUS.user_profile.context.online_bspec.user_number_list[index] = driver["user_number"];
                GAME_STATUS.user_profile.context.online_bspec.driver_level_list[index] = driver["level"];
                GAME_STATUS.user_profile.context.online_bspec.driver_list[index] = driver["name"];

                ++index;
            }
        }

        var index_list = Array(gp0.event.entry_set.entry_generate.cars.size);
        {
            for (var i = 0; i < gp0.event.entry_set.entry_generate.cars.size; ++i)
                index_list[i] = i;
        }

        index_list.randomShuffle(pdistd::GetSystemTimeMicroSecond());
        index = 0;
        var cp_list = [];
        {
            for (var i = 0; i < dp_list.size; ++i)
            {
                var ii = i % gp0.event.entry_set.entry_generate.cars.size;
                var car_label = gp0.event.entry_set.entry_generate.cars[index_list[ii]];
                var cp = gtengine::MCarParameter(car_label);
                var color_max = cp.getColorMax();
                cp.color = pdistd::MRandom::GetValue(0, color_max);
                cp.target = driver_index_list[i] == 0;
                cp_list.push(cp);

                ++index;
            }
        }

        var course_code = course_info.code;
        var laps = gp0.event.race_parameter.race_limit_laps;

        GAME_STATUS.user_profile.context.online_bspec.course_label = course_info.name;
        GAME_STATUS.user_profile.context.online_bspec.laps = laps;
        GAME_STATUS.user_profile.context.online_bspec.lock_minutes = gp0.event.information.race_info_minute;

        GameParameterUtil::setListForArena(gp0, cp_list, dp_list);
        gp0.event.replay.auto_save = auto_save;
        Grim2Util::PUTLOG::REMOTE_RACE::begin(course_info.name, dp_list.size, gp0.game_id, laps, auto_save, plan_id);
        SoundUtil::BGMPlayGroup(SoundUtil::SCENE_RACE, "racing", nil, 0.0, 3.0);

        GameParameterUtil::execute(context, gp0, nil, nil, nil, user_id_list);
    }
}