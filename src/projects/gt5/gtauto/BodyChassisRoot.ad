module ROOT
{
    #include "StoreBase.ad"

    function initCodeMap()
    {
        setMap([
            ["lightweight_01", "lightweight_01"], 
            ["lightweight_02", "lightweight_02"], 
            ["lightweight_03", "lightweight_03"], 
            ["stiffness",      "stiffness_01"], 
            ["window",         "lightweight_window_01"], 
            ["bonnet",         "lightweight_bonnet_02"],
            ["bonnet_c",       "lightweight_bonnet_01"]
        ]);
    }

    function initPriceText()
    {
        LightWeight::lightweight_01::Cr::CrText.text = getPriceText(code_map_.find("lightweight_01")[1]);
        LightWeight::lightweight_02::Cr::CrText.text = getPriceText(code_map_.find("lightweight_02")[1]);
        LightWeight::lightweight_03::Cr::CrText.text = getPriceText(code_map_.find("lightweight_03")[1]);
        LightWeightBody::stiffness::info::Cr::CrText.text = getPriceText(code_map_.find("stiffness")[1]);
        LightWeightBody::window::info::Cr::CrText.text = getPriceText(code_map_.find("window")[1]);
        LightWeightBody::bonnet::info::Cr::CrText.text = getPriceText(code_map_.find("bonnet")[1]);
        LightWeightBody::bonnet_c::info::Cr::CrText.text = getPriceText(code_map_.find("bonnet_c")[1]);

        checkPartsStatus(LightWeight::lightweight_01);
        checkPartsStatus(LightWeight::lightweight_02);
        checkPartsStatus(LightWeight::lightweight_03);
        checkPartsStatus(LightWeightBody::stiffness);
        checkPartsStatus(LightWeightBody::window);
        checkPartsStatus(LightWeightBody::bonnet);
        checkPartsStatus(LightWeightBody::bonnet_c);
    }

    function initFocus()
    {
        ROOT.setFocus(LightWeight::lightweight_01);
    }

    function capture(context)
    {
        if (sNeedCapture)
        {
            var capturing_car = function () 
            {
                SceneFaceForCapture.visible = true;
                ThumbnailUtil::captureIconForGarage(context, 
                SceneFaceForCapture, GAME_STATUS.user_profile.garage.riding_id, 
                ROOT::sRidingCar, ["M", "L"]);
                SceneFaceForCapture.visible = false;

                return true;
            };

            DialogUtil::openConfirmExecDialog(context, nil, 
            context.translate(ROOT, "MyHome", "UPDATA_CAR_DATA"), 
            nil, nil, capturing_car, nil);
        }
    }


    module ROOT::LightWeight
    {
        method onActivate(context, event)
        {
            return openPurchasingPopup(context, event);
        }

        method onFocusEnter(context, event)
        {
            getItemCount(event.widget);
            ROOT::Count2::Count::haveCountText::FadeActor.start();

            return EVENTRESULT_CONTINUE;
        }

        method onFocusLeave(context, event)
        {
            ROOT::Count2::Count::haveCountText::FadeActor.reset();
            ROOT::Count2::Count::haveCountText.text = "";

            return EVENTRESULT_CONTINUE;
        }
    }

    module LightWeightBody
    {
        method onActivate(context, event)
        {
            var ret = openPurchasingPopup(context, event);
            LightWeightBody::bonnet.ItemStatus.image_path = "";
            LightWeightBody::bonnet_c.ItemStatus.image_path = "";
            checkPartsStatus(LightWeightBody::bonnet);
            checkPartsStatus(LightWeightBody::bonnet_c);

            return ret;
        }

        method onFocusEnter(context, event)
        {
            getItemCount(event.widget);
            ROOT::Count2::Count::haveCountText::FadeActor.start();

            return EVENTRESULT_CONTINUE;
        }

        method onFocusLeave(context, event)
        {
            ROOT::Count2::Count::haveCountText::FadeActor.reset();
            ROOT::Count2::Count::haveCountText.text = "";

            return EVENTRESULT_CONTINUE;
        }
    }
}