    function start_refresh_bodyrigidity(context, index, icon, coupon_name)
    {
        var have_paid = ROOT::PayMoney(context, ROOT::sWagesList.refresh_bodyrigidity, coupon_name);
        if (!have_paid)
            return;

        context.cursor_visible = false;
        context.event_mask = 5;
        context.disableInput();

        ROOT::Each.hide(context, false);
        ROOT::Menus.hide(context, false);
        ROOT::SceneFace.setSceneDriver(0);
        ROOT::SceneFace.setSceneDriver(1);

        var scene_settings = ROOT::SceneFace::SceneSettings(end_refresh_bodyrigidity, nil, nil, nil, nil, "sound_gt/gt5/gtauto/gtauto_body_engine");

        ROOT::SceneFace.startSceneScript(context, "GT_AUTO_garage", scene_settings);
    }

    function start_refresh_bodyrigidity_free(context, index, icon)
    {
        main::sound.play("ok");
        start_refresh_bodyrigidity(context, index, icon, "body_refresh_ticket");
    }

    function end_refresh_bodyrigidity(context)
    {
        ROOT::sRidingCar.body_life = 0.0;
        ROOT::sRidingCar.rainX = 0.0;
        ROOT::sRidingCar.dirtiness = 0.0;
        ROOT::UpdateRidingCar();

        ROOT::sNeedChangeCar1 = true;
        ROOT::SceneFaceCover.setVisible("Default");

        ROOT::Menus.setMenuIcons(context, BackMenus);
        ROOT::Menus.appear(context, false);
        context.event_mask = 5;
        context.enableInput();
        context.cursor_visible = true;
    }

    function remain_refresh_bodyrigidity_coupon(context)
    {
        return GameItemUtil::ItemBox::getNumByCode("body_refresh_ticket");
    }

    static sRM;

    function on_racing_modify(context, focus_index)
    {
        var rm_code = ROOT::sRidingCar.getRacingModifyCode();
        if (rm_code == nil)
        {
            main::sound.play("disable");
            ROOT::MessageArea::MessageWindow::FadeActor.reset();

            DialogUtil::openConfirmDialog(context, DialogUtil::ERROR, context.translate(ROOT, "MESSAGE_THIS_CAR_CANNOT_MODIFY"));

            return;
        }

        main::sound.play("ok");

        ROOT::sShopFrontFocus = focus_index;
        ROOT::sRM = gtengine::MCarParameter(rm_code);
        ROOT::PP_PS_Change.setup_racing_modify(ROOT::sRidingCar, rm_code);

        var rm_label = ROOT::sRM.getCarLabel();
        ROOT::Each::RacingModify::Flyer::image01.image_path = "piece/racingmodify_flyer/%{rm_label}_01.img";
        ROOT::Each::RacingModify::Flyer::image02.image_path = "piece/racingmodify_flyer/%{rm_label}_02.img";

        var scene_settings = ROOT::SceneFace::SceneSettings(end_racing_modify, nil, nil, nil, "racingmodify_bg");
        ROOT::SceneFaceCover.setVisible("Default");
        ROOT::SceneFace.startSceneScript(context, "GT_AUTO_racing_modify_preview", scene_settings);
        ROOT::MyHome.hide(context, false);
        ROOT::PP_PS_Change.appear(context, false);
        ROOT::Each.appear(context, "RacingModify", false);
        ROOT::Menus.swapMenuIcons(context, RacingModifyMenus);
    }

    function start_racing_modify(context, index, icon)
    {
        main::sound.play("ok");
        
        var accept = DialogUtil::openConfirmDialog(context, DialogUtil::DEFAULT_NO, context.translate(ROOT, "MESSAGE_CONFIRM_MODIFY"));
        if (!accept)
            return;

        var have_paid = ROOT::PayMoney(context, ROOT::sWagesList.racing_modify);
        if (!have_paid)
        {
            ROOT::sRM = nil;
            return;
        }

        context.cursor_visible = false;
        context.event_mask = 5;
        context.disableInput();

        ROOT::PP_PS_Change.hide(context, false);
        ROOT::Each.hide(context, false);
        ROOT::Menus.hide(context, false);
        ROOT::SceneFace.setSceneDriver(0);

        ROOT::SceneFace.changeCar(ROOT::sRM, 1);
        ROOT::SceneFace.setSceneDriver(1);

        var scene_settings = ROOT::SceneFace::SceneSettings(end_racing_modify, 
        nil, nil, nil, nil, "sound_gt/gt5/gtauto/gtauto_body_engine");

        ROOT::SceneFace.startSceneScript(context, "GT_AUTO_garage", scene_settings);
    }

    function work_racing_modify(cp, code)
    {
        cp.applyRacingModify(code);
        cp.setNewCar();

        cp.rainX = 0.0;
        cp.dirtiness = 0.0;
        cp.body_life = 0.0;
        cp.setReplaceOil();
        cp.setPaintColor(0, -1);
        cp.setWheelPaintColor(0, -1);
        cp.wheel = 0;
        cp.wheel_color = 0;
    }

    function end_racing_modify(context)
    {
        PDINetwork.unlockTrophyAsync(gtengine::TrophyType::MODIFYING_CAR);
        work_racing_modify(ROOT::sRidingCar, ROOT::sRidingCar.getRacingModifyCode());

        ROOT::HeaderGT5::HBox::RidingCar.refresh(context);
        var garage_id = ROOT::sRidingCar.garage_id;
        var current_slot = GAME_STATUS.user_profile.garage.getCurrentSlot(garage_id);

        for (var slot = 0; slot < 3; ++slot)
        {
            if (current_slot == slot)
                continue;

            GAME_STATUS.user_profile.garage.changeSlot(garage_id, slot);
            var other_cp = GAME_STATUS.user_profile.garage.getCar(garage_id);
            other_cp.deepCopy(ROOT::sRidingCar);
            other_cp.updateScratch();
        }

        GAME_STATUS.user_profile.garage.changeSlot(garage_id, current_slot);
        ROOT::UpdateRidingCar();
        GAME_STATUS.user_profile.garage.updateCarName(garage_id, ROOT::sRidingCar.getCarCode());

        ROOT::sRM = nil;
        ROOT::sNeedCapture = true;
        ROOT::sNeedChangeCar1 = true;
        ROOT::sNeedCleanDirtiness = true;

        ROOT::Menus.setMenuIcons(context, BackMenus);
        ROOT::Menus.appear(context, false);
        context.event_mask = 5;
        context.enableInput();
        context.cursor_visible = true;
    }

    static ShopFrontMenus = [
        ShopMenuIcon("icon_carwash",             "CAR_WASH",         "HELP_CAR_WASH",         on_wash_car, nil), 
        ShopMenuIcon("icon_oilchange",           "OIL_CHANGE",       "HELP_OIL_CHANGE",       on_change_oil, nil), 
        ShopMenuIcon("icon_paintbody",           "BODY_PAINT",       "HELP_BODY_PAINT",       on_paint_body, nil), 
        ShopMenuIcon("icon_paintwheels",         "WHEEL_PAINT",      "HELP_WHEEL_PAINT",      on_paint_wheels, nil), 
        ShopMenuIcon("icon_changewheels",        "WHEEL_CHANGE",     "HELP_WHEEL_CHANGE",     on_change_wheels, nil), 
        ShopMenuIcon("icon_aeroparts",           "AERO_PARTS",       "HELP_AERO_PARTS",       on_aero_parts, nil), 
        ShopMenuIcon("icon_enguneoverhaul",      "ENGINE_OVERHAUL",  "HELP_ENGINE_OVERHAUL",  on_engine_overhaul, nil), 
        ShopMenuIcon("icon_refreshbodyregidity", "CHASSIS_RIGIDITY", "HELP_CHASSIS_RIGIDITY", on_refresh_bodyrigidity, nil), 
        ShopMenuIcon("icon_racingmodify",        "RACING_MODIFY",    "HELP_RACING_MODIFY",    on_racing_modify, nil)
    ];

    static WashCarMenus = [
        ShopMenuIcon("icon_carwash",      "WASHING_START", nil, start_wash_car,       go_shop_front, nil), 
        CouponIcon("icon_coupon_carwash", "USE_COUPON",    nil, start_wash_car_free,  go_shop_front, nil, remain_wash_car_coupon), 
        ShopMenuIcon("icon_back",         "BACK",          nil, return_to_shop_front, go_shop_front, nil)
    ];

    static ChangeOilMenus = [
        ShopMenuIcon("icon_oilchange",      "OIL_CHANGE_START", nil, start_change_oil,      go_shop_front, nil), 
        CouponIcon("icon_coupon_oilchange", "USE_COUPON",       nil, start_change_oil_free, go_shop_front, nil, remain_change_oil_coupon), 
        ShopMenuIcon("icon_back",           "BACK",             nil, return_to_shop_front,  go_shop_front, nil)
    ];

    static PaintBodyMenus = [
        ShopMenuIcon("icon_selectcolor", "SELECT_COLOR", nil, select_body_color,    go_shop_front, nil), 
        ShopMenuIcon("icon_back",        "BACK",         nil, return_to_shop_front, go_shop_front, nil)
    ];

    static PaintBodyMenus2 = [
        ShopMenuIcon("icon_paintbody",   "PAINTING_START", nil, start_paint_body,     go_shop_front, nil), 
        ShopMenuIcon("icon_selectcolor", "SELECT_COLOR",   nil, select_body_color,    go_shop_front, nil), 
        ShopMenuIcon("icon_back",        "BACK",           nil, return_to_shop_front, go_shop_front, nil)
    ];

    static PaintWheelsMenus = [
        ShopMenuIcon("icon_selectcolor", "SELECT_COLOR", nil, select_wheels_color,  go_shop_front, nil), 
        ShopMenuIcon("icon_back",        "BACK",         nil, return_to_shop_front, go_shop_front, nil)
    ];

    static PaintWheelsMenus2 = [
        ShopMenuIcon("icon_paintwheels", "PAINTING_START", nil, start_paint_wheels,   go_shop_front, nil), 
        ShopMenuIcon("icon_selectcolor", "SELECT_COLOR",   nil, select_wheels_color,  go_shop_front, nil), 
        ShopMenuIcon("icon_back",        "BACK",           nil, return_to_shop_front, go_shop_front, nil)
    ];

    static AeroPartsMenus = [
        ShopMenuIcon("icon_aeroparts", "AERO_CHANGE_START", nil, start_aero_parts,  cancel_aero_parts, nil), 
        ShopMenuIcon("icon_back",      "BACK",              nil, return_aero_parts, cancel_aero_parts, nil)
    ];

    static EngineOverhaulMenus = [
        ShopMenuIcon("icon_enguneoverhaul",      "ENGINE_OVERHAUL_START", nil, start_engine_overhaul,     go_shop_front, nil), 
        CouponIcon("icon_coupon_engineoverhaul", "USE_COUPON",           nil, start_engine_overhaul_free, go_shop_front, nil, remain_engine_overhaul_coupon), 
        ShopMenuIcon("icon_back",                "BACK",                 nil, return_to_shop_front,       go_shop_front, nil)
    ];

    static RefreshBodyRigidityMenus = [
        ShopMenuIcon("icon_refreshbodyregidity", "CHASSIS_RIGIDITY_START", nil, start_refresh_bodyrigidity,      go_shop_front, nil), 
        CouponIcon("icon_coupon_refreshbody",    "USE_COUPON",             nil, start_refresh_bodyrigidity_free, go_shop_front, nil, remain_refresh_bodyrigidity_coupon), 
        ShopMenuIcon("icon_back",                "BACK",                   nil, return_to_shop_front,            go_shop_front, nil)
    ];

    static RacingModifyMenus = [
        ShopMenuIcon("icon_racingmodify", "RACING_MODIFY_START", nil, start_racing_modify,  go_shop_front, nil), 
        ShopMenuIcon("icon_back",         "BACK",                nil, return_to_shop_front, go_shop_front, nil)
    ];

    static BackMenus = [
        ShopMenuIcon("icon_back", "BACK", nil, return_to_shop_front, go_shop_front, nil)
    ];
}

module ROOT::Menus
{
    attribute finder_;

    method onFocus(context)
    {
        self.finder_.onFocus(context, ROOT);
    }

    method setMenuIcons(context, menus, focus_index)
    {
        var initial_data = Menus.makeMenusInitialData(context, menus, focus_index);
        ROOT::Menus.finder_.replaceFolder(context, initial_data);
    }

    method setWheelIcons(context, menus, focus_index)
    {
        var initial_data = Menus.makeWheelsInitialData(context, menus, focus_index);
        ROOT::Menus.finder_.replaceFolder(context, initial_data);

        if (initial_data.h_scrollbar_ != nil)
            initial_data.h_scrollbar_.adjustment.adjust();
    }

    method swapMenuIcons(context, menus, focus_index, fade_end_func)
    {
        if (menus.size == 0)
            return;

        ROOT::MessageArea::MessageWindow::FadeActor.reset();
        ROOT::MessageArea::MessageWindow::TextFace.text = "";
        self.hide(context, false);
        context.sync(self.MoveEffect.total_time);

        if (fade_end_func != nil)
            fade_end_func(context);

        if (menus[0].isInstanceOf(ROOT::WheelIcon))
            self.setWheelIcons(context, menus, focus_index);
        else
            self.setMenuIcons(context, menus, focus_index);

        self.appear(context, false);
    }

    method appear(context, warp)
    {
        context.event_mask = 5;
        context.disableInput();

        var end_effect = method (context) 
        {
            context.event_mask = 5;
            context.enableInput();

            context.pushEvent(main::menu::MFunctionEvent(self.finder_.onFocus, context, ROOT));
            self.MoveEffect.on_effect_end = nil;
        };

        self.MoveEffect.reverse = false;
        self.MoveEffect.on_effect_end = self.*end_effect;
        self.MoveEffect.start();

        if (warp)
            self.MoveEffect.warp();
    }

    method hide(context, warp)
    {
        BalloonTip.reset_value();
        ROOT.setFocus(nil);
        self.MoveEffect.reverse = true;
        self.MoveEffect.start();

        if (warp)
            self.MoveEffect.warp();
    }

    method onInitialize(context)
    {
        var dummy_initial_data = UIKitProject::FinderRoot.InitialData(UIKitProject::FinderRoot.makeCandidates([]));
        self.finder_ = UIKitProject::FinderRoot::setCopy(context, self, dummy_initial_data, false);

        hide(context, true);
    }

    method onFinalize(context)
    {
        if (self.finder_ != nil)
        {
            var parent = self.finder_.parent;
            parent.removeChild(context, self.finder_);
        }
    }

    method cb_selected_icon(context, folder_data, close, arg)
    {
        var candidate_data = folder_data.getItemData();
        var icon = candidate_data.value_;
        if (icon.on_activate_func_ != nil)
            icon.on_activate_func_(context, candidate_data.item_index_, icon);
    }

    method cb_canceled_icon(context, folder_data, func_popup_close)
    {
        var candidate_data = folder_data.getItemData();
        var icon = candidate_data.value_;

        if (icon.on_cancel_func_ != nil)
        {
            main::sound.play("cancel");
            icon.on_cancel_func_(context);
        }
        else
        {
            if (PROJECT::DIRECT_CANCEL_BACK)
            {
                main::sound.play("return");
                close(context);
            }
            else
            {
                main::sound.play("cancel");
                ROOT.setFocus(MyHome);
            }
        }
    }

    method cb_init_icon(context, candidate_data, item_w, arg) 
    {
        var icon = candidate_data.value_;

        if (icon.isInstanceOf(ROOT::ShopMenuIcon))
        {
            item_w.ImageFace.from_disk = false;
            item_w.ImageFace.image_path = "image/gt5/gtauto/%{icon.image_}.dds";
            item_w.Remain.visible = false;
        }
        else if (icon.isInstanceOf(ROOT::WheelIcon))
        {
            if (icon.is_revert_icon_)
            {
                item_w.ImageFace.from_disk = false;
                item_w.ImageFace.image_path = "image/gt5/gtauto/%{icon.image_}.dds";
            }
            else
            {
                item_w.ImageFace.from_disk = true;
                item_w.ImageFace.image_path = "car/wheel_thumb/%{icon.image_}";
            }
        }
        else if (icon.isInstanceOf(ROOT::CouponIcon))
        {
            item_w.ImageFace.from_disk = false;
            item_w.ImageFace.image_path = "image/gt5/gtauto/%{icon.image_}.dds";

            if (icon.get_remain_func_ != nil)
                item_w.Remain::TextFace.text = icon.get_remain_func_(context);

            item_w.Remain.visible = true;
        }
    }

    method cb_focused_icon(context, candidate_data, item_w, arg)
    {
        var icon = candidate_data.value_;

        if (icon.isInstanceOf(ROOT::ShopMenuIcon) || icon.isInstanceOf(ROOT::CouponIcon))
        {
            BalloonTip.set_value(context, item_w, context.translate(ROOT, icon.caption_), 38);

            if (icon.help_message_ != nil)
            {
                MessageArea::MessageWindow.opacity = 0.01;
                MessageArea::MessageWindow.cx = item_w.sx + (item_w.w / 2);
                MessageArea::MessageWindow::TextFace.text = context.translate(ROOT, icon.help_message_);
                context.wait(0.01);
                MessageArea::MessageWindow::FadeActor.restart();
            }
        }
        else if (icon.isInstanceOf(ROOT::WheelIcon))
        {
            if (icon.is_revert_icon_)
            {
                BalloonTip.set_value(context, item_w, 
                context.translate(ROOT, icon.caption_), 38);
            }
            else
            {
                BalloonTip.set_value(context, item_w, 
                context.translate(ROOT, "WheelThumbnailName", icon.caption_), 38);
            }
        }

        if (icon.on_focus_func_ != nil)
            icon.on_focus_func_(context, candidate_data.item_index_, icon);
    }

    method cb_leaved_icon(context, candidate_data, item_w, arg)
    {
        BalloonTip.reset_value();

        var icon = candidate_data.value_;
        if (icon.isInstanceOf(ROOT::ShopMenuIcon))
        {
            if (icon.help_message_ != nil)
            {
                MessageArea::MessageWindow::FadeActor.reset();
                MessageArea::MessageWindow::TextFace.text = "";
            }
        }
    }

    method makeMenusInitialData(context, menu_icons, focus_index)
    {
        if (focus_index == nil)
            focus_index = 0;

        MenusBox.h_scacing = menu_icons.size < 6 ? 15.0 : 0.0; // TYPO: scacing

        var initial_data = UIKitProject::FinderRoot::InitialData(UIKitProject::FinderRoot.makeCandidates(menu_icons));
        initial_data.view_type_ = UIKitProject::FinderRoot::ViewType::SCROLL_H;
        initial_data.extended_item_ = hidden::IconItem;
        initial_data.import_iconbox_parameter_ = self.MenusBox;
        initial_data.cb_init_item_ = self.cb_init_icon;
        initial_data.cb_on_activate_ = self.cb_selected_icon;
        initial_data.cb_on_cancel_ = self.cb_canceled_icon;
        initial_data.cb_focus_enter_ = self.cb_focused_icon;
        initial_data.cb_focus_leave_ = self.cb_leaved_icon;
        initial_data.focus_index_ = focus_index;
        initial_data.activate_sound_ = nil;

        return initial_data;

    }

    method makeWheelsInitialData(context, wheel_icons, focus_index)
    {
        if (focus_index == nil)
            focus_index = 0;

        var initial_data = UIKitProject::FinderRoot::InitialData(UIKitProject::FinderRoot.makeCandidates(wheel_icons));
        initial_data.view_type_ = UIKitProject::FinderRoot::ViewType::SCROLL_H;
        initial_data.extended_item_ = hidden::WheelItem;
        initial_data.import_iconbox_parameter_ = self.WheelsBox;
        initial_data.cb_init_item_ = self.cb_init_icon;
        initial_data.cb_on_activate_ = self.cb_selected_icon;
        initial_data.cb_on_cancel_ = self.cb_canceled_icon;
        initial_data.cb_focus_enter_ = self.cb_focused_icon;
        initial_data.h_scrollbar_ = self.Each::ChangeWheels::HScrollbar;
        initial_data.focus_index_ = focus_index;
        initial_data.activate_sound_ = nil;

        return initial_data;
    }
}

module ROOT::SceneFace
{
    attribute scene_settings_;
    attribute current_cp_;

    class SceneSettings
    {
        attribute scene_end_func_;
        attribute scene_end_func_args_;
        attribute scene_start_func_;
        attribute scene_start_func_args_;
        attribute scene_bg_;
        attribute scene_sound_;
        attribute fadeout_end_func_;
        attribute fadeout_end_func_args_;

        method __init__(scene_end_func, scene_end_func_args, scene_start_func, scene_start_func_args, scene_bg, scene_sound)
        {
            self.scene_end_func_ = scene_end_func;
            self.scene_end_func_args_ = scene_end_func_args;
            self.scene_start_func_ = scene_start_func;
            self.scene_start_func_args_ = scene_start_func_args;
            self.scene_bg_ = scene_bg;
            self.scene_sound_ = scene_sound;
        }

        method set_fadeout_end_func(fadeout_end_func, fadeout_end_func_args)
        {
            self.fadeout_end_func_ = fadeout_end_func;
            self.fadeout_end_func_args_ = fadeout_end_func_args;
        }

        method set_scene_start_func(scene_start_func, scene_start_func_args)
        {
            self.scene_start_func_ = scene_start_func;
            self.scene_start_func_args_ = scene_start_func_args;
        }

        method set_scene_end_func(scene_end_func, scene_end_func_args)
        {
            self.scene_end_func_ = scene_end_func;
            self.scene_end_func_args_ = scene_end_func_args;
        }

        method set_bg(scene_bg)
        {
            self.scene_bg_ = scene_bg;
        }

        method set_sound(scene_sound)
        {
            self.scene_sound_ = scene_sound;
        }
    }

    method startSceneScript(context, scene_script, scene_settings, no_fade)
    {
        self.scene_settings_ = scene_settings;

        var end_effect = method (context) 
        {
            if (self.scene_settings_ != nil && self.scene_settings_.scene_bg_ != nil)
                SceneFace.image_path = "image/gt5/gtauto/%{self.scene_settings_.scene_bg_}.dds";

            if (self.scene_settings_ != nil && self.scene_settings_.fadeout_end_func_ != nil)
            {
                var fadeout_end_func = self.scene_settings_.fadeout_end_func_;
                self.scene_settings_.scene_start_func_ = nil;
                var fadeout_end_func_args = self.scene_settings_.fadeout_end_func_args_;
                self.scene_settings_.fadeout_end_func_args_ = nil;

                fadeout_end_func(context, fadeout_end_func_args);
            }

            SceneFaceUtil::loadScene(self, scene_script);
            SceneFaceUtil::SetSignalHandler(self, SceneFaceUtil::HandleType::SCENE_START);
            self.saveCommandQueue();
            ROOT::SceneFaceCover::FadeActor.on_effect_end = nil;
        };

        if (no_fade == true)
        {
            SceneFaceUtil::loadScene(self, scene_script);
            SceneFaceUtil::SetSignalHandler(self, SceneFaceUtil::HandleType::SCENE_START);
        }
        else
            ROOT::SceneFaceCover.appear(context, false, self.*end_effect);
    }

    method onSignal(context, enum, param)
    {
        if (enum == SceneFaceUtil::HandleType::SCENE_START)
        {
            if (self.scene_settings_ != nil && self.scene_settings_.scene_sound_ != nil)
                SoundUtil::PlayStreamSE(self.scene_settings_.scene_sound_);

            syncUnderSetup(context);

            if (self.scene_settings_ != nil && self.scene_settings_.scene_start_func_ != nil)
            {
                var scene_start_func = self.scene_settings_.scene_start_func_;
                self.scene_settings_.scene_start_func_ = nil;
                var scene_start_func_args = self.scene_settings_.scene_start_func_args_;
                self.scene_settings_.scene_start_func_args_ = nil;

                scene_start_func(context, scene_start_func_args);
            }

            ROOT::SceneFaceCover.hide(context, false);
        }

        if (enum == "FADE_OUT_START")
        {
            if (self.scene_settings_ != nil && self.scene_settings_.scene_end_func_ != nil)
            {
                var scene_end_func = self.scene_settings_.scene_end_func_;
                self.scene_settings_.scene_end_func_ = nil;
                var scene_end_func_args = self.scene_settings_.scene_end_func_args_;
                self.scene_settings_.scene_end_func_args_ = nil;

                scene_end_func(context, scene_end_func_args);
            }
        }
    }

    method setDefaultCar(cp, car_num, dp)
    {
        self.setDefaultCarParameter(cp, car_num)

        if (dp != nil)
            self.setDefaultCarDriverParameter(dp, car_num);
    }

    method changeCar(cp, car_num, reset_command_queue = true)
    {
        if (reset_command_queue)
            self.resetCommandQueue();

        ROOT::SceneFace.setDefaultCar(cp, car_num);
        ROOT::SceneFace.execCommand("changeLodCar _default%{car_num} car%{car_num + 1}");
        ROOT::SceneFace.execCommand("swapCarTexture code:tx0009 dirt car%{car_num + 1}");
    }

    method cleanDirtiness(car_num)
    {
        ROOT::SceneFace.execCommand("requestCarDirtiness 0.0 car%{car_num + 1}");
    }

    method setSceneDriver(car_num)
    {
        SceneFaceUtil::loadScene(ROOT::SceneFace, "GT_AUTO_car%{car_num + 1}_driver");
    }

    method changeWheels(wheel, wheel_color, car_num)
    {
        self.resetCommandQueue();

        ROOT::SceneFace.execCommand("setCarWheelVariation %{wheel} car%{car_num + 1}");
        ROOT::SceneFace.execCommand("setCarWheelColorVariation %{wheel_color} car%{car_num + 1}");
    }

    method setCarCustomParts(parts_type, parts, car_num)
    {
        var scene_parts_types = [
            gtengine::CarPartsType::WING : 2, 
            gtengine::CarPartsType::AERO1 : 3, 
            gtengine::CarPartsType::AERO2 : 4, 
            gtengine::CarPartsType::AERO3 : 5
        ];

        var scene_parts_type = scene_parts_types[parts_type];
        self.resetCommandQueue();

        ROOT::SceneFace.execCommand("setCarCustomParts %{scene_parts_type} %{parts} car%{car_num + 1}");
    }

    method syncUnderSetup(context)
    {
        for (;;)
        {
            if (!self.isUnderSetup())
                return;

            Thread::Sleep(0.1);
        }
    }
}

module ROOT::Each
{
    attribute visible_widget_;

    method appear(context, visible_widget_name, warp)
    {
        self.insensitive = false;

        for (var it = self.first; it != nil; it = it.next_widget)
        {
            it.visible = it.name == visible_widget_name;
            it.insensitive = !(it.name == visible_widget_name);
        }

        self.visible_widget_ = self[visible_widget_name];
        if (self.visible_widget_ != nil && self.visible_widget_["on_appear"] != nil)
            self.visible_widget_.on_appear(context);

        self.FadeActor.reverse = false;
        self.FadeActor.start();
        if (warp)
            self.FadeActor.warp();

        if (visible_widget_name == "RacingModify")
        {
            self.RacingModify::Flyer::image01::FadeActor.restart();
            self.RacingModify::Flyer::image02::FadeActor.restart();
        }
    }

    method hide(context, warp)
    {
        self.insensitive = true;
        if (self.visible_widget_ != nil && self.visible_widget_["on_hide"] != nil)
            self.visible_widget_.on_hide(context);

        for (var it = self.first; it != nil; it = it.next_widget)
            it.insensitive = true;

        self.FadeActor.reverse = true;
        self.FadeActor.start();

        if (warp)
            self.FadeActor.warp();
    }

    method setup_wages(wages_list)
    {
        self.WashCar::Wages::Price.text = main::pdiext::MMisc::GetMoneyString(wages_list.wash_car);
        self.ChangeOil::Wages::Price.text = main::pdiext::MMisc::GetMoneyString(wages_list.change_oil);
        self.PaintBody::Wages::Price.text = main::pdiext::MMisc::GetMoneyString(wages_list.paint_body);
        self.PaintWheels::Wages::Price.text = main::pdiext::MMisc::GetMoneyString(wages_list.paint_wheels);
        self.ChangeWheels::Wages::Price.text = main::pdiext::MMisc::GetMoneyString(wages_list.change_wheels);
        self.AeroParts::Wages::Price.text = main::pdiext::MMisc::GetMoneyString(0);
        self.EngineOverhaul::Wages::Price.text = main::pdiext::MMisc::GetMoneyString(wages_list.engine_overhaul);
        self.RefreshBodyRigidity::Wages::Price.text = main::pdiext::MMisc::GetMoneyString(wages_list.refresh_bodyrigidity);
        self.RacingModify::Wages::Price.text = main::pdiext::MMisc::GetMoneyString(wages_list.racing_modify);
    }

    method onInitialize(context)
    {
        var dec_arrow_actor = self.ChangeWheels::HScrollbar::dec_arrow::arrow_actor;
        dec_arrow_actor.reverse = true;
        dec_arrow_actor.reset();

        var inc_arrow_actor = self.ChangeWheels::HScrollbar::inc_arrow::arrow_actor;
        inc_arrow_actor.reverse = true;
        inc_arrow_actor.reset();
    }
}

module ROOT::PP_PS_Change
{
    method onInitialize(context)
    {
        var unit_pp = context.translate(ROOT, "Unit", "PERFORMANCE_POINT");
        self.PP_Before::PP_Values::PP.text = unit_pp;
        self.PP_After::PP_Values::PP.text = unit_pp;

        var unit_power = pdiext::MUnit::GetUnitOfPower();
        self.PS_Before::PS_Values::PS.text = unit_power;
        self.PS_After::PS_Values::PS.text = unit_power;
    }

    method appear(context, warp)
    {
        if (!EVENTRESULT_STOP)
            return;

        self.FadeActor.reverse = false;
        self.FadeActor.start();

        if (warp)
            self.FadeActor.warp();
    }

    method hide(context, warp)
    {
        self.FadeActor.reverse = true;
        self.FadeActor.start();

        if (warp)
            self.FadeActor.warp();
    }

    method _get_pp_and_power(cp)
    {
        cp.permanentlyBeginInfo();
        var pp = cp.getPP1000();
        |var power| = cp.getPower();

        return [pp, power];
    }

    method _setup(pp, pp2, power, power2)
    {
        if (pp == pp2)
        {
            self.PP_Before::PP_Values::TextFace.text = pp;
            self.PP_After::PP_Values::TextFace_Same.text = pp2;
            self.PP_After::PP_Values::TextFace_Same.visible = true;
            self.PP_After::PP_Values::TextFace_Change.visible = false;
        }
        else
        {
            self.PP_Before::PP_Values::TextFace.text = pp;
            self.PP_After::PP_Values::TextFace_Change.text = pp2;
            self.PP_After::PP_Values::TextFace_Change.visible = true;
            self.PP_After::PP_Values::TextFace_Same.visible = false;
        }

        if (power == power2)
        {
            self.PS_Before::PS_Values::TextFace.text = power;
            self.PS_After::PS_Values::TextFace_Same.text = power2;
            self.PS_After::PS_Values::TextFace_Same.visible = true;
            self.PS_After::PS_Values::TextFace_Change.visible = false;
        }
        else
        {
            self.PS_Before::PS_Values::TextFace.text = power;
            self.PS_After::PS_Values::TextFace_Change.text = power2;
            self.PS_After::PS_Values::TextFace_Change.visible = true;
            self.PS_After::PS_Values::TextFace_Same.visible = false;
        }
    }

    method setup_racing_modify(base_cp, rm_code)
    {
        if (!EVENTRESULT_STOP)
            return;

        var cp = gtengine::MCarParameter();
        cp.deepCopy(base_cp);

        |var pp, var power| = _get_pp_and_power(cp);
        ROOT::work_racing_modify(cp, rm_code);
        |var pp2, var power2| = _get_pp_and_power(cp);

        _setup(pp, pp2, pdiext::MUnit::GetPowerForDisplay(power), pdiext::MUnit::GetPowerForDisplay(power2));
    }

    method setup_change_oil(base_cp)
    {
        if (!1)
            return;

        var cp = gtengine::MCarParameter();
        cp.deepCopy(base_cp);

        |var pp, var power| = _get_pp_and_power(cp);
        cp.setReplaceOil();
        |var pp2, var power2| = _get_pp_and_power(cp);

        _setup(pp, pp2, pdiext::MUnit::GetPowerForDisplay(power), pdiext::MUnit::GetPowerForDisplay(power2));
    }

    method setup_engine_overhaul(base_cp)
    {
        var cp = gtengine::MCarParameter();
        cp.deepCopy(base_cp);

        |var pp, var power| = _get_pp_and_power(cp);
        work_engine_overhaul(cp);
        |var pp2, var power2| = _get_pp_and_power(cp);

        _setup(pp, pp2, pdiext::MUnit::GetPowerForDisplay(power), pdiext::MUnit::GetPowerForDisplay(power2));
    }

    method setup_aero_parts(base_cp, parts_list)
    {
        if (!1)
            return;

        var cp = gtengine::MCarParameter();
        cp.deepCopy(base_cp);

        |var pp, var power| = _get_pp_and_power(cp);
        var pp2 = pp;
        var power2 = power;

        if (parts_list.size > 0)
        {
            cp.beginPartsInfo();
            foreach (var parts in parts_list)
            {
                |var parts_type_index, var parts_index| = parts;
                cp.setParts(parts_type_index, parts_index);
            }

            cp.endPartsInfo();
            |pp2, power2| = _get_pp_and_power(cp);
        }

        _setup(pp, pp2, pdiext::MUnit::GetPowerForDisplay(power), pdiext::MUnit::GetPowerForDisplay(power2))
    }
}

module ROOT::SceneFaceCover
{
    attribute visible_widget_;

    method setVisible(visible_widget_name)
    {
        for (var it = self.first; it != nil; it = it.next_widget)
            it.visible = it.name == visible_widget_name;
    }

    method appear(context, warp, on_effect_end, duration = 0.0)
    {
        if (!self.FadeActor.reverse && self.FadeActor.ramain_time == 0.0)
        {
            if (on_effect_end != nil)
                on_effect_end(context);

            return;
        }

        self.FadeActor.reverse = false;
        self.FadeActor.setStartDuration(0, duration);
        self.FadeActor.on_effect_end = on_effect_end;
        self.FadeActor.start();

        if (warp)
            self.FadeActor.warp();
    }

    method hide(context, warp, on_effect_end, duration = 0.0)
    {
        if (self.FadeActor.reverse && self.FadeActor.ramain_time == 0.0)
        {
            if (on_effect_end != nil)
                on_effect_end(context);

            return;
        }

        self.FadeActor.reverse = true;
        self.FadeActor.setStartDuration(0, duration);
        self.FadeActor.on_effect_end = on_effect_end;
        self.FadeActor.start();

        if (warp)
            self.FadeActor.warp();
    }
}

module ROOT::OilGauge
{
    method appear(context, warp)
    {
        self.Gauge::HActor.reverse = false;
        self.Gauge::HActor.reset();
        self.FadeActor.reverse = false;
        self.FadeActor.start();

        if (warp)
            self.FadeActor.warp();
    }

    method hide(context, warp)
    {
        self.FadeActor.reverse = true;
        self.FadeActor.start();

        if (warp)
            self.FadeActor.warp();
    }

    method onInitialize(context)
    {
        self.Gauge::fresh.toScreenCoord();
        self.Gauge::old.toScreenCoord();
        self.Gauge::old_6000.toScreenCoord();
    }

    method setOilLife(oil_life)
    {
        if (oil_life < 5000 * 1000)
        {
            var clamp_size_min = 0 * 1000;
            var clamp_size_max = 600 * 1000;

            if (oil_life > clamp_size_max)
                oil_life = clamp_size_max;

            oil_life -= clamp_size_min;
            if (oil_life < 0)
                oil_life = 0;

            var old_oil_opacity = oil_life.toFloat() / (clamp_size_max - clamp_size_min);
            self.Gauge::old.opacity = old_oil_opacity;
            self.Gauge::old_6000.opacity = 0.0;
        }
        else
        {
            var clamp_size_min = 5000 * 1000;
            var clamp_size_max = 6000 * 1000;

            if (oil_life > clamp_size_max)
                oil_life = clamp_size_max;

            oil_life -= clamp_size_min;
            if (oil_life < 0)
                oil_life = 0;

            var old_oil_opacity = oil_life.toFloat() / (clamp_size_max - clamp_size_min);
            self.Gauge::old_6000.opacity = old_oil_opacity;
            self.Gauge::old.opacity = 1.0;
        }
    }

    method startChangeOilAnimation()
    {
        var end_effect = method (context) 
        {
            self.Gauge::old.opacity = 0.0;
            self.Gauge::old_6000.opacity = 0.0;
            self.Gauge::HActor.on_effect_end = nil;
            self.Gauge::HActor.reverse = true;
            self.Gauge::HActor.start();
        };

        self.Gauge::HActor.reverse = false;
        self.Gauge::HActor.on_effect_end = self.*end_effect;
        self.Gauge::HActor.start();
    }
}

module ROOT::Each::AeroParts::PartsSelect
{
    attribute cp;
    attribute current;

    class PartsType
    {
        attribute code;
        attribute wages;

        method __init__(code, wages)
        {
            self.code = code;
            self.wages = wages;
        }
    }

    static sSelectedParts = [gtengine::CarPartsType::AERO1];
    static sPartsTypes = [
        PartsType("AERO1", "front_aero"), PartsType("AERO2", "rear_aero"), 
        PartsType("AERO3", "front_extension"), PartsType("WING", "rear_wing")
    ];

    method onInitialize(context)
    {
        self.change_tab("AERO1");
    }

    method setup(context, cp)
    {
        var is_exist_parts = false;
        cp.beginPartsInfo();

        foreach (var parts_type in sPartsTypes)
        {
            var parts_type_index = gtengine::CarPartsType[parts_type.code];
            var current_parts_index = cp.getParts(parts_type_index);
            var wages = ROOT::sWagesList[parts_type.wages];
            var i = 0;
            var is_exist_parts_type = false;

            for (var it = self[parts_type.code].first; it != nil; it = it.next_widget)
            {
                if (it.name != "Normal")
                {
                    var parts_index = gtengine["PARTS_%{parts_type.code}"][it.name];
                    var is_active = parts_index == current_parts_index;
                    if (parts_index != nil)
                    {
                        var is_exist = cp.isExistParts(parts_type_index, parts_index);
                        it.visible = is_exist;
                        it.isCurrent.active = is_active;
                        it.active = is_active;

                        if (is_exist)
                        {
                            it.Label_Type.text = context.translate(ROOT, "TYPE_%{i + 1}");
                            i++;
                            is_exist_parts = true;
                            is_exist_parts_type = true;
                        }
                    }

                    it.Credit.text = "Cr." + main::pdiext::MMisc::GetMoneyString(wages);
                }

                else
                {
                    var no_parts = current_parts_index <= 0;
                    it.active = no_parts;
                    it.isCurrent.active = no_parts;

                    if (no_parts)
                        it.Credit.text = "";
                    else
                        it.Credit.text = "Cr." + main::pdiext::MMisc::GetMoneyString(10000 / 100);
                }
            }

            self[parts_type.code]["Normal"].visible = is_exist_parts_type;
        }

        cp.endPartsInfo();
        if (!is_exist_parts)
            return false;

        self.updateTotalWages();
        self.change_tab("AERO1");

        return true;
    }

    method getResult(context)
    {
        var total_wages = 0;
        var parts_list = Array();
        var all_normal = true;

        foreach (var parts_type in sPartsTypes)
        {
            var parts_type_index = gtengine::CarPartsType[parts_type.code];
            for (var it = self[parts_type.code].first; it != nil; it = it.next_widget)
            {
                var is_current = it.isCurrent.active;
                var seleted_parts = it.active;
                {
                    if (it.name != "Normal")
                    {
                        {
                            var parts_index = gtengine["PARTS_%{parts_type.code}"][it.name];
                            if (seleted_parts && !is_current)
                            {
                                parts_list.push([parts_type_index, parts_index]);
                                total_wages += ROOT::sWagesList[parts_type.wages];
                            }
                        
                            if (seleted_parts)
                                all_normal = false;
                        }
                    
                        continue;
                    }
                
                    if (seleted_parts && !is_current)
                    {
                        parts_list.push([parts_type_index, 0]);
                        total_wages += 10000 / 100;
                    }
                }
            }
        }

        return [total_wages, parts_list, all_normal];
    }

    method change_tab(target_tab)
    {
        var tabs = ["AERO1", "AERO2", "AERO3", "WING"];

        foreach (var tab in tabs)
        {
            var is_target = target_tab == tab;

            self.Tabs::BGs[tab]["Active"].opacity = is_target ? 1.0 : 0.0;
            self.Tabs::BGs[tab]["Deactive"].opacity = is_target ? 0.0 : 1.0;

            if (self[tab] != nil)
                self[tab].visible = is_target;
        }

        self.current = target_tab;
    }

    method updateTotalWages()
    {
        var total_wages = 0;
        var parts_list = Array();

        foreach (var parts_type in sPartsTypes)
        {
            var parts_type_index = gtengine::CarPartsType[parts_type.code];
            for (var it = self[parts_type.code].first; it != nil; it = it.next_widget)
            {
                var is_current = it.isCurrent.active;
                var seleted_parts = it.active;
                {
                    if (it.name != "Normal")
                    {
                        {
                            var parts_index = gtengine["PARTS_%{parts_type.code}"][it.name];
                            if (seleted_parts && !is_current)
                                total_wages += ROOT::sWagesList[parts_type.wages];
                        }

                        continue;
                    }

                    if (seleted_parts && !is_current)
                        total_wages += 10000 / 100;
                }
            }
        }

        AeroParts::Wages::Price.text = main::pdiext::MMisc::GetMoneyString(total_wages);
    }

    method onActivate(context, event)
    {
        main::sound.play("checkbox");
        var parent = event.widget.parent;

        for (var it = parent.first; it != nil; it = it.next_widget)
        {
            var active = it == event.widget;
            if (active)
            {
                var parts_type_code = parent.name;
                var parts_type_index = gtengine::CarPartsType[parts_type_code];
                if (it.name != "Normal")
                {
                    var parts_index = gtengine["PARTS_%{parts_type_code}"][it.name];
                    if (parts_index != nil)
                        SceneFace.setCarCustomParts(parts_type_index, parts_index, 0);
                }
                else
                    SceneFace.setCarCustomParts(parts_type_index, 0, 0);
            }

            it.active = active;
        }

        self.updateTotalWages();
        |var total_price, var parts_list, var all_normal| = self.getResult(context);
        ROOT::PP_PS_Change.setup_aero_parts(sRidingCar, parts_list);

        return EVENTRESULT_FILTER;
    }

    method onCancel(context)
    {
        ROOT::Menus.onFocus(context);
        return EVENTRESULT_FILTER;
    }

    method onFocusEnter(context)
    {
        BalloonTip.reset_value();
        return EVENTRESULT_FILTER;
    }

    module Tabs
    {
        method onActivate(context, event)
        {
            main::sound.play("tab_switch");
            self.PartsSelect.change_tab(event.widget.name);

            return EVENTRESULT_FILTER;
        }
    }
}

module ROOT::MyHome
{
    method appear(context, warp)
    {
        self.insensitive = false;
        self.FadeActor.reverse = false;
        self.FadeActor.start();

        if (warp)
            self.FadeActor.warp();
    }

    method hide(context, warp)
    {
        self.insensitive = true;
        self.FadeActor.reverse = true;
        self.FadeActor.start();

        if (warp)
            self.FadeActor.warp();
    }

    method onActivate(context)
    {
        sound.play("return");
        close(context);
    
        return EVENTRESULT_FILTER;
    }

    method onCancel(context)
    {
        sound.play("return");
        close(context);
    
        return EVENTRESULT_FILTER;
    }

    method onFocusEnter(context, event)
    {
        ROOT::MessageArea::MessageWindow::FadeActor.reset();
        BalloonTip.set_value(context, event.widget, 
        context.translate(ROOT, "MyHome", "MYHOME_BACK_BUTTON"), 20);

        return EVENTRESULT_STOP;
    }

    method onFocusLeave(context, event)
    {
        ROOT::BalloonTip.reset_value();
        return EVENTRESULT_STOP;
    }
}

module ROOT::Debug
{
    method refresh()
    {
        var debug_message = "";

        debug_message += "- car parameter -";
        debug_message += "dirtiness   = %{sRidingCar.dirtiness}\n";
        debug_message += "rainX       = %{sRidingCar.rainX}\n";
        debug_message += "oil_life    = %{sRidingCar.oil_life}\n";
        debug_message += "engine_life = %{sRidingCar.engine_life}\n";
        debug_message += "body_life   = %{sRidingCar.body_life}\n";

        self.info.text = debug_message;
        self.visible = true;
    }
}