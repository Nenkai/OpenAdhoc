module ROOT
{
    #include "StoreBase.ad"

    function initCodeMap()
    {
        setMap([
            ["Brake01Text", "brake_01"], 
            ["Brake02Text", "brake_02"], 
            ["Brake03Text", "brake_03"], 
            ["BrakeBalance01Text", "brake_balance_01"]
        ]);
    }

    function initPriceText()
    {
        Brake::Brake01CrText.text = ROOT::getPriceText(ROOT::code_map_.find("Brake01Text")[1]);
        Brake::Brake02CrText.text = ROOT::getPriceText(ROOT::code_map_.find("Brake02Text")[1]);
        Brake::Brake03CrText.text = ROOT::getPriceText(ROOT::code_map_.find("Brake03Text")[1]);
        Brake::Brake04CrText.text = "--";
        Brake::BrakeBalance01CrText.text = ROOT::getPriceText(ROOT::code_map_.find("BrakeBalance01Text")[1]);
    }

    function initFocus()
    {
        ROOT.setFocus(Brake::Brake01Text);
    }

    function capture()
    {

    }

    module ROOT::Brake
    {
        method onActivate(context, event)
        {
            return openPurchasingPopup(context, event);
        }

        method onFocusEnter(context, event)
        {
            getItemCount(event.widget);

            return EVENTRESULT_CONTINUE;
        }

        method onFocusLeave(context, event)
        {
            ROOT::Count2::Count::haveCountText.text = 0;

            return EVENTRESULT_CONTINUE;
        }
    }
}