module RaceProject
{
    module PluginModule
    {
        #include "ModuleEvent.ad"
    }

    #include "projects/gt5/race/OnlineRankingUpload.ad"
}

module PROJECT
{
    import RaceProject::*;
    
    function isSeasonalEvent(gp)
    {
        return gp.game_id >= 1000000;
    }
}