module ROOT
{
    #include "StoreBase.ad"

    function initCodeMap()
    {
        setMap([
            ["clutch01",         "clutch_01"], 
            ["clutch02",         "clutch_02"], 
            ["flywheel01",       "flywheel_01"], 
            ["flywheel02",       "flywheel_02"], 
            ["Lsd01",            "lsd_01"], 
            ["CenterDiff01",     "center_diff_01"], 
            ["Propellershaft01", "propellershaft_01"]
        ]);
    }

    function initPriceText()
    {
        Clutch::clutch01::Cr::CrText.text = getPriceText(code_map_.find("clutch01")[1]);
        Clutch::clutch02::Cr::CrText.text = getPriceText(code_map_.find("clutch02")[1]);
        Flywheel::flywheel01::Cr::CrText.text = getPriceText(code_map_.find("flywheel01")[1]);
        Flywheel::flywheel02::Cr::CrText.text = getPriceText(code_map_.find("flywheel02")[1]);
        drivetrain::Lsd01::info::Cr::CrText.text = getPriceText(code_map_.find("Lsd01")[1]);
        drivetrain::CenterDiff01::info::Cr::CrText.text = getPriceText(code_map_.find("CenterDiff01")[1]);
        drivetrain::Propellershaft01::info::Cr::CrText.text = getPriceText(code_map_.find("Propellershaft01")[1]);

        checkPartsStatus(Clutch::clutch01);
        checkPartsStatus(Clutch::clutch02);
        checkPartsStatus(Flywheel::flywheel01);
        checkPartsStatus(Flywheel::flywheel02);
        checkPartsStatus(drivetrain::Lsd01);
        checkPartsStatus(drivetrain::CenterDiff01);
        checkPartsStatus(drivetrain::Propellershaft01);
    }

    function initFocus()
    {
        ROOT.setFocus(Clutch::clutch01);
    }

    function capture()
    {

    }

    module ROOT::Clutch
    {
        method onActivate(context, event)
        {
            return openPurchasingPopup(context, event);
        }

        method onFocusEnter(context, event)
        {
            getItemCount(event.widget);
            ROOT::Count2::Count::haveCountText::FadeActor.start();

            return EVENTRESULT_CONTINUE;
        }

        method onFocusLeave(context, event)
        {
            ROOT::Count2::Count::haveCountText::FadeActor.reset();
            ROOT::Count2::Count::haveCountText.text = "";

            return EVENTRESULT_CONTINUE;
        }
    }

    module ROOT::Flywheel
    {
        method onActivate(context, event)
        {
            return openPurchasingPopup(context, event);
        }

        method onFocusEnter(context, event)
        {
            getItemCount(event.widget);
            ROOT::Count2::Count::haveCountText::FadeActor.start();

            return EVENTRESULT_CONTINUE;
        }

        method onFocusLeave(context, event)
        {
            ROOT::Count2::Count::haveCountText::FadeActor.reset();
            ROOT::Count2::Count::haveCountText.text = "";

            return EVENTRESULT_CONTINUE;
        }
    }

    module ROOT::drivetrain
    {
        method onActivate(context, event)
        {
            return openPurchasingPopup(context, event);
        }

        method onFocusEnter(context, event)
        {
            getItemCount(event.widget);
            ROOT::Count2::Count::haveCountText::FadeActor.start();

            return EVENTRESULT_CONTINUE;
        }

        method onFocusLeave(context, event)
        {
            ROOT::Count2::Count::haveCountText::FadeActor.reset();
            ROOT::Count2::Count::haveCountText.text = "";

            return EVENTRESULT_CONTINUE;
        }
    }
}