module ROOT
{
    hidden.visible = false;
    Debug.visible = false;

    static sRidingCar;
    static sShopFrontFocus = 0;
    static sNeedCapture;
    static sNeedChangeCar1;
    static sNeedChangeCar2;
    static sNeedCleanDirtiness;

    // JP Price, divide by 100 for anywhere else 
    #define WASH_PRICE (5000 / 100)
    #define OIL_CHANGE_PRICE (25000 / 100)
    #define PAINT_BODY_PRICE (200000 / 100)
    #define PAINT_WHEEL_PRICE (200000 / 100)
    #define CHANGE_WHEEL_PRICE (350000 / 100)

    #define ENGINE_OVERHAUL_PRICE_MULTIPLIER 0.3
    #define ENGINE_OVERHAUL_MAX_PRICE (50000000 / 100)
    #define ENGINE_OVERHAUL_MIN_PRICE (50000 / 100)
    #define ENGINE_OVERHAUL_PRICE_ROUNDING (50000 / 100)
    #define ENGINE_OVERHAUL_PRICE_FLOOR (100000 / 100)

    #define BODY_RIGIDITY_PRICE_MULTIPLIER 0.5
    #define BODY_RIGIDITY_MAX_PRICE (50000000 / 100)
    #define BODY_RIGIDITY_MIN_PRICE (50000 / 100)
    #define BODY_RIGIDITY_PRICE_ROUNDING (50000 / 100)
    #define BODY_RIGIDITY_PRICE_FLOOR (500000 / 100)

    #define FRONT_AERO_PRICE_MULTIPLIER 0.08
    #define FRONT_AERO_MIN_PRICE (50000 / 100)
    #define FRONT_AERO_PRICE_ROUNDING (50000 / 100)
    #define FRONT_AERO_PRICE_FLOOR (50000 / 100)

    #define REAR_AERO_PRICE_MULTIPLIER 0.07
    #define REAR_AERO_MIN_PRICE (50000 / 100)
    #define REAR_AERO_PRICE_ROUNDING (50000 / 100)
    #define REAR_AERO_PRICE_FLOOR (50000 / 100)

    #define FRONT_EXTENSION_PRICE_MULTIPLIER 0.01
    #define FRONT_EXTENSION_MIN_PRICE (50000 / 100)
    #define FRONT_EXTENSION_PRICE_ROUNDING (50000 / 100)
    #define FRONT_EXTENSION_PRICE_FLOOR (20000 / 100)

    #define REAR_WING_PRICE_MULTIPLIER 0.05
    #define REAR_WING_MIN_PRICE (50000 / 100)
    #define REAR_WING_PRICE_ROUNDING (50000 / 100)
    #define REAR_WING_PRICE_FLOOR (50000 / 100)

    class wages_list
    {
        static wash_car;
        static change_oil;
        static paint_body;
        static paint_wheels;
        static change_wheels;
        static engine_overhaul;
        static refresh_bodyrigidity;
        static racing_modify;
        static front_aero;
        static rear_aero;
        static front_extension;
        static rear_wing;

        method calculate(car_code)
        {
            self.wash_car = WASH_PRICE;
            self.change_oil = OIL_CHANGE_PRICE;
            self.paint_body = PAINT_BODY_PRICE;
            self.paint_wheels = PAINT_WHEEL_PRICE;
            self.change_wheels = CHANGE_WHEEL_PRICE;

            var rm_code = ROOT::sRidingCar.getRacingModifyCode();
            if (rm_code != nil)
                self.racing_modify = gtengine::MSpecDB::getCarPrice(rm_code);
            else
                self.racing_modify = -1;

            var car_price = gtengine::MSpecDB::getCarPrice(car_code);

            // Engine Overhaul
            var engine_overhaul_base_price = car_price * ENGINE_OVERHAUL_PRICE_MULTIPLIER;
            if (engine_overhaul_base_price > ENGINE_OVERHAUL_MAX_PRICE)
                self.engine_overhaul = ENGINE_OVERHAUL_MAX_PRICE;
            else if (engine_overhaul_base_price > ENGINE_OVERHAUL_PRICE_ROUNDING)
            {
                self.engine_overhaul = ((engine_overhaul_base_price.toInt() / ENGINE_OVERHAUL_PRICE_ROUNDING) * ENGINE_OVERHAUL_PRICE_ROUNDING).toInt();
                if (self.engine_overhaul < ENGINE_OVERHAUL_PRICE_FLOOR)
                    self.engine_overhaul = ENGINE_OVERHAUL_PRICE_FLOOR;
            }
            else
                self.engine_overhaul = ENGINE_OVERHAUL_MIN_PRICE;

            // Body Rigidity
            var refresh_bodyrigidity_base_price = car_price * BODY_RIGIDITY_PRICE_MULTIPLIER;
            if (refresh_bodyrigidity_base_price > BODY_RIGIDITY_MAX_PRICE)
                self.refresh_bodyrigidity = BODY_RIGIDITY_MAX_PRICE;
            else if (refresh_bodyrigidity_base_price > BODY_RIGIDITY_PRICE_ROUNDING)
            {
                self.refresh_bodyrigidity = ((refresh_bodyrigidity_base_price.toInt() / BODY_RIGIDITY_PRICE_ROUNDING) * BODY_RIGIDITY_PRICE_ROUNDING).toInt();
                if (self.refresh_bodyrigidity < BODY_RIGIDITY_PRICE_FLOOR)
                    self.refresh_bodyrigidity = BODY_RIGIDITY_PRICE_FLOOR;
            }
            else
                self.refresh_bodyrigidity = BODY_RIGIDITY_MIN_PRICE;

            // Front Aero
            var front_aero_base_price = car_price * FRONT_AERO_PRICE_MULTIPLIER;
            if (front_aero_base_price > FRONT_AERO_PRICE_ROUNDING)
            {
                self.front_aero = ((front_aero_base_price.toInt() / FRONT_AERO_PRICE_ROUNDING) * FRONT_AERO_PRICE_ROUNDING).toInt();
                if (self.front_aero < FRONT_AERO_PRICE_FLOOR)
                    self.front_aero = FRONT_AERO_PRICE_FLOOR;
            }
            else
                self.front_aero = FRONT_AERO_MIN_PRICE;

            // Rear Aero
            var rear_aero_base_price = car_price * REAR_AERO_PRICE_MULTIPLIER;
            if (rear_aero_base_price > REAR_AERO_PRICE_ROUNDING)
            {
                self.rear_aero = ((rear_aero_base_price.toInt() / REAR_AERO_PRICE_ROUNDING) * REAR_AERO_PRICE_ROUNDING).toInt();
                if (self.rear_aero < REAR_AERO_PRICE_FLOOR)
                    self.rear_aero = REAR_AERO_PRICE_FLOOR;
            }
            else
                self.rear_aero = REAR_AERO_MIN_PRICE;

            // Front Extension
            var front_extension_base_price = car_price * FRONT_EXTENSION_PRICE_MULTIPLIER;
            if (front_extension_base_price > FRONT_EXTENSION_PRICE_ROUNDING)
            {
                self.front_extension = ((front_extension_base_price.toInt() / FRONT_EXTENSION_PRICE_ROUNDING) * FRONT_EXTENSION_PRICE_ROUNDING).toInt();
                if (self.front_extension < FRONT_EXTENSION_PRICE_FLOOR)
                    self.front_extension = FRONT_EXTENSION_PRICE_FLOOR;
            }
            else
                self.front_extension = FRONT_EXTENSION_MIN_PRICE;

            // Rear Wing
            var rear_wing_base_price = car_price * REAR_WING_PRICE_MULTIPLIER;
            if (rear_wing_base_price > REAR_WING_PRICE_ROUNDING)
            {
                self.rear_wing = ((rear_wing_base_price.toInt() / REAR_WING_PRICE_ROUNDING) * REAR_WING_PRICE_ROUNDING).toInt();
                if (self.rear_wing < REAR_WING_PRICE_FLOOR)
                    self.rear_wing = REAR_WING_PRICE_FLOOR;
            }
            else
                self.rear_wing = REAR_WING_MIN_PRICE;
        }

        method __get_elem__(i)
        {
            return self.getObjectAttribute(i);
        }
    }

    static sWagesList = wages_list();

    method open(context)
    {
        SequenceUtil::startPageDirect(context, self);
    }

    method close(context)
    {
        ROOT::MessageArea::MessageWindow::FadeActor.reset();
        BalloonTip.reset_value();

        if (main::GAME_STATUS.user_profile.context.need_save == SaveDataUtilGT5::STATUSCODE::NEED_SAVE)
        {
            SaveDataUtilGT5::saveEveryWhere(context);
            main::GAME_STATUS.user_profile.context.need_save = SaveDataUtilGT5::STATUSCODE::CHECK_SAVE;
        }

        ROOT::Each.hide(context, false);
        ROOT::Menus.hide(context, false);
        self.SceneFaceCover.setVisible("Default");
        self.SceneFaceCover.appear(context, false);

        if (sNeedCapture)
        {
            var capturing_car = function () 
            {
                SceneFaceForCapture.visible = true;
                ThumbnailUtil::captureIconForGarage(context, SceneFaceForCapture, 
                GAME_STATUS.user_profile.garage.riding_id, ROOT::sRidingCar, ["M", "L"]);

                SceneFaceForCapture.visible = false;
                return true;
            };

            DialogUtil::openConfirmExecDialog(context, nil, 
            context.translate(ROOT, "UPDATA_CAR_DATA"), nil, nil, capturing_car, nil);
        }

        SequenceUtil::startProject(context, "gtmode");
    }

    method onInitialize(context)
    {
        ROOT::sShopFrontFocus = 0;
        ROOT::sPaintItem = nil;
        ROOT::sRidingCar = nil;
        ROOT::sOnAeroPartsMenu = false;
        ROOT::sNeedCapture = false;
        ROOT::sNeedChangeCar1 = false;
        ROOT::sNeedChangeCar2 = false;
        ROOT::sNeedCleanDirtiness = false;

        self.SceneFaceCover.setVisible("Default");
        self.SceneFaceCover.hide(context, true);

        ButtonHelpGT5.set(context, [
            [ButtonHelpGT5.getEnterButtonName(), context.translate(ROOT, "Component", "Enter")], 
            [ButtonHelpGT5.getCancelButtonName(), context.translate(ROOT, "Component", "Cancel")]
        ]);

        ROOT::sRidingCar = GAME_STATUS.user_profile.garage.getRidingCar();
        ROOT::sRidingCar.setSuitableTiresWithTrunk(gtengine::MSpecDB::getCourseCode("suzuka"));
        ROOT::sRidingCar.beginSetting();

        var dp = GAME_STATUS.user_profile.residence.getPlayer(0);
        self.SceneFace.setDefaultCar(ROOT::sRidingCar, 0, dp);
        self.SceneFace.setDefaultCar(ROOT::sRidingCar, 1, dp);

        var scene_settings = self.SceneFace::SceneSettings(nil, nil, onMenuStart, nil);
        self.SceneFace.startSceneScript(context, "GT_AUTO_entrance", scene_settings);
        ROOT::sWagesList.calculate(ROOT::sRidingCar.getCarCode());
        self.Each.setup_wages(ROOT::sWagesList);
        PROJECT::ignorePadEvent(true);

        context.cursor_visible = false;
        self.MyHome.appear(context, true);
        self.Each.hide(context, true);
        self.PP_PS_Change.hide(context, true);
        self.OilGauge.hide(context, true);
        self.Menus.setMenuIcons(context, ShopFrontMenus);
        self.Menus.hide(context, true);

        context.pushEvent(main::menu::MFunctionEvent(postInitialize, context));
    }

    method onLoad(context)
    {
        hidden::IconItem::Remain.visible = false;
        hidden::IconItem::ImageFace.image_path = "";
        hidden::WheelItem::ImageFace.image_path = "";
        ROOT::Each::RacingModify::Flyer::image01.image_path = "";
        ROOT::Each::RacingModify::Flyer::image01.image_path = ""; // BUG: Dupe?
    }

    method postInitialize(context)
    {

    }

    method onFinalize(context)
    {
        ROOT::sRidingCar.endSetting();

        ROOT::sRidingCar = nil;
        ROOT::sShopFrontFocus = 0;
        ROOT::sPaintItem = nil;
        ROOT::sRM = nil;
        ROOT::sOnAeroPartsMenu = false;
        ROOT::sNeedCapture = false;
        ROOT::sNeedChangeCar1 = false;
        ROOT::sNeedChangeCar2 = false;
        ROOT::sNeedCleanDirtiness = false;
    }

    method onMenuStart(context)
    {
        context.pageInRootTransition();
        SoundUtil::MenuBGMCrossfadeGroup("gtauto", 0.0, 0.0);
        PROJECT::ignorePadEvent(false);
        self.Menus.appear(context, false);
        self.openModeIntroduction(context);
    }

    method openModeIntroduction(context)
    {
        if (!GAME_STATUS.user_profile.game_flags.getFlag("INTRODUCTION", "GTAUTO"))
        {
            context.wait(0.5);
            ROOT::MessageArea::MessageWindow::FadeActor.reset();

            DialogUtil::openInformationDialog(context, context.translate(ROOT, "IntroductionGT5", "GTAUTO"));
            GAME_STATUS.user_profile.game_flags.setFlag("INTRODUCTION", "GTAUTO", true);
        }
    }

    function CheckDebugCommand(context)
    {
        if (pdiext::isQABuild())
        {
            var state = context.getUpdateContext().getPadButtonState(0);
            if (state & 0x800)
                return "badly_car_condition_and_cash_plus";
            else if (state & 0x100)
                return "badly_car_condition_and_cash_zero";
        }

        return "";
    }

    method onKeyPress(context, event)
    {
        if (ROOT::sOnAeroPartsMenu && event.keysym == CELL_PAD_CTRL_TRIANGLE)
        {
            on_key_press_aero_parts(context);
            return EVENTRESULT_FILTER;
        }

        return EVENTRESULT_CONTINUE;
    }

    method onKeyRelease(context, event)
    {
        if (ROOT::sOnAeroPartsMenu && event.keysym == CELL_PAD_CTRL_TRIANGLE)
        {
            on_key_release_aero_parts(context);
            return EVENTRESULT_FILTER;
        }

        return EVENTRESULT_CONTINUE;
    }

    class Icon
    {
        attribute image_;
        attribute caption_;
        attribute on_activate_func_;
        attribute on_cancel_func_;
        attribute on_focus_func_;

        method __init__(image, caption, on_activate_func, on_cancel_func, on_focus_func)
        {
            self.image_ = image;
            self.caption_ = caption;
            self.on_activate_func_ = on_activate_func;
            self.on_cancel_func_ = on_cancel_func;
            self.on_focus_func_ = on_focus_func;
        }
    }

    class ShopMenuIcon : Icon
    {
        attribute help_message_;

        method __init__(image, caption, help_message_, on_activate_func, on_cancel_func, on_focus_func)
        {
            self.help_message_ = help_message_;
            self.__super__::__init__(image, caption, on_activate_func, on_cancel_func, on_focus_func);
        }
    }

    class CouponIcon : Icon
    {
        attribute help_message_;
        attribute get_remain_func_;

        method __init__(image, caption, help_message_, on_activate_func, on_cancel_func, on_focus_func, get_remain_func)
        {
            self.get_remain_func_ = get_remain_func;
            self.help_message_ = help_message_;
            self.__super__::__init__(image, caption, on_activate_func, on_cancel_func, on_focus_func);
        }
    }

    class WheelIcon : Icon
    {
        attribute wheel_;
        attribute wheel_color_;
        attribute is_revert_icon_;

        method __init__(wheel, wheel_color, image, caption, on_activate_func, on_cancel_func, on_focus_func)
        {
            self.wheel_ = wheel;
            self.wheel_color_ = wheel_color;
            self.is_revert_icon_ = wheel == 0 ? true : false;
            self.__super__::__init__(image, caption, on_activate_func, on_cancel_func, on_focus_func);
        }
    }

    function getAnotherColorCar()
    {
        var cp = gtengine::MCarParameter(ROOT::sRidingCar.getCarLabel());
        cp.color = ROOT.sRidingCar.color;

        var variation = main::gtengine::MSpecDB::getCarVariation(cp.getCarLabel());
        if (variation > 1)
        {
            for (;;)
            {
                var next_color = pdistd::MRandom::GetValue(0, variation - 1);
                if (next_color != cp.color)
                {
                    cp.color = next_color;
                    break;
                }
            }
        }

        return cp;
    }

    function UpdateRidingCar()
    {
        ROOT::sRidingCar.endSetting();
        ROOT::sRidingCar.updateScratch();
        GAME_STATUS.user_profile.garage.updateRidingCar();
        ROOT::sRidingCar.beginSetting();

        GAME_STATUS.user_profile.context.need_save = SaveDataUtilGT5::STATUSCODE::NEED_SAVE;
    }

    function PayMoney(context, wages, coupon_name)
    {
        var mycash = &main::GAME_STATUS.user_profile.cash;
        if (coupon_name != nil)
        {
            var item;
            switch (coupon_name)
            {
                case "car_wash_ticket":
                    item = GameItemUtil::getCarWashTicket();
                    break;
                case "oil_change_ticket":
                    item = GameItemUtil::getOilChangeTicket();
                    break;
                case "overhaul_ticket":
                    item = GameItemUtil::getOverHaulicket();  // TYPO: icket (but function name matches)
                    break;
                case "body_refresh_ticket":
                    item = GameItemUtil::getBodyRefreshTicket();
                    break;
            }

            var msg = context.translate(ROOT, "MESSAGE_DO_YOU_USE_COUPON").build(item.item_name);
            var accept = DialogUtil::openConfirmDialog(context, DialogUtil::YESNO, msg);
            if (accept)
            {
                main::sound.play("buy_shop");
                GameItemUtil::ItemBox::delete2(item);
                return true;
            }
            else
                return false;
        }

        if (*mycash >= wages)
        {
            main::sound.play("buy_shop");
            *mycash -= wages;

            ROOT::HeaderGT5::HBox::Credits.refresh();
            GAME_STATUS.user_profile.context.need_save = SaveDataUtilGT5::STATUSCODE::NEED_SAVE;

            return true;
        }
        else
        {
            main::sound.play("disable");
            DialogUtil::openConfirmDialog(context, DialogUtil::ERROR, 
            context.translate(ROOT, "MESSAGE_NOT_ENOUGH_CREDITS"));

            return false;
        }
    }

    function change_car_if(context)
    {
        if (ROOT::sNeedChangeCar1)
        {
            ROOT::SceneFace.changeCar(sRidingCar, 0, false);
            ROOT::sNeedChangeCar1 = false;
        }

        if (ROOT::sNeedChangeCar2)
        {
            ROOT::SceneFace.changeCar(sRidingCar, 1, false);
            ROOT::sNeedChangeCar2 = false;
        }

        if (ROOT::sNeedCleanDirtiness)
        {
            ROOT::SceneFace.cleanDirtiness(0);
            ROOT::sNeedCleanDirtiness = false;
        }

        SceneFace.syncUnderSetup(context);
    }

    function go_shop_front(context)
    {
        ROOT::sPaintItem = nil;
        ROOT::sRM = nil;
        PROJECT::ignorePadEvent(true);

        ROOT::sOnAeroPartsMenu = false;

        var scene_settings = ROOT::SceneFace::SceneSettings(nil, nil, nil, nil, "sceneface_bg");
        ROOT::SceneFace.startSceneScript(context, "GT_AUTO_entrance2", scene_settings);

        ROOT::PP_PS_Change.hide(context, false);
        ROOT::OilGauge.hide(context, false);
        ROOT::Each.hide(context, false);
        ROOT::MyHome.appear(context, false);
        ROOT::Menus.swapMenuIcons(context, ShopFrontMenus, ROOT::sShopFrontFocus, change_car_if);

        ButtonHelpGT5.set(context, [
            [ButtonHelpGT5.getEnterButtonName(), context.translate(ROOT, "Component", "Enter")], 
            [ButtonHelpGT5.getCancelButtonName(), context.translate(ROOT, "Component", "Cancel")]
        ]);

        PROJECT::ignorePadEvent(false);
    }

    function return_to_shop_front(context, args)
    {
        main::sound.play("ok");
        go_shop_front(context);
    }

    function ignore(context)
    {

    }

    function on_wash_car(context, focus_index)
    {
        if (ROOT::sRidingCar.dirtiness == 0.0 && ROOT::sRidingCar.rainX == 0.0)
        {
            main::sound.play("disable");
            ROOT::MessageArea::MessageWindow::FadeActor.reset();

            DialogUtil::openConfirmDialog(context, DialogUtil::ERROR, 
            context.translate(ROOT, "MESSAGE_NO_NEED_TO_WASH_CAR"));
            return;
        }

        main::sound.play("ok");

        var menu_icons = WashCarMenus;
        if (remain_wash_car_coupon(context) == 0)
        {
            menu_icons = [];
            foreach (var menu_icon in WashCarMenus)
            {
                if (!menu_icon.isInstanceOf(ROOT::CouponIcon))
                    menu_icons.push(menu_icon);
            }
        }

        ROOT::sShopFrontFocus = focus_index;
        ROOT::SceneFaceCover.setVisible("Default");
        var is_racing_kart = gtengine::MSpecDB::checkGenericFlag("is_racing_kart", sRidingCar.getCarCode());
        if (is_racing_kart)
            ROOT::SceneFace.startSceneScript(context, "GT_AUTO_carwash_wait_NoChara");
        else
            ROOT::SceneFace.startSceneScript(context, "GT_AUTO_carwash_wait")

        ROOT::MyHome.hide(context, false);
        ROOT::Each.appear(context, "WashCar", false);
        ROOT::Menus.swapMenuIcons(context, menu_icons);
    }

    function start_wash_car(context, index, icon, coupon_name)
    {
        var have_paid = ROOT::PayMoney(context, ROOT::sWagesList.wash_car, coupon_name);
        if (!have_paid)
            return;

        context.cursor_visible = false;
        context.event_mask = 5;
        context.disableInput();
        ROOT::Each.hide(context, false);
        ROOT::Menus.hide(context, false);

        var scene_settings = ROOT::SceneFace::SceneSettings(end_wash_car, nil, nil, nil, nil, "sound_gt/gt5/gtauto/gtauto_wash");
        var is_racing_kart = gtengine::MSpecDB::checkGenericFlag("is_racing_kart", sRidingCar.getCarCode());
        if (is_racing_kart)
            ROOT::SceneFace.startSceneScript(context, "GT_AUTO_carwash_NoChara", scene_settings);
        else
            ROOT::SceneFace.startSceneScript(context, "GT_AUTO_carwash", scene_settings);
    }

    function start_wash_car_free(context, index, icon)
    {
        main::sound.play("ok");
        start_wash_car(context, index, icon, "car_wash_ticket");
    }

    function end_wash_car(context)
    {
        ROOT::sRidingCar.rainX = 0.0;
        ROOT::sRidingCar.dirtiness = 0.0;
        ROOT::UpdateRidingCar();

        ROOT::sNeedCleanDirtiness = true;
        ROOT::Menus.setMenuIcons(context, BackMenus);
        Menus.appear(context, false);
        context.event_mask = 5;
        context.enableInput();
        context.cursor_visible = true;
    }

    function remain_wash_car_coupon(context)
    {
        return GameItemUtil::ItemBox::getNumByCode("car_wash_ticket");
    }

    function on_change_oil(context, focus_index)
    {
        if (ROOT::sRidingCar.isOilJustReplaced())
        {
            main::sound.play("disable");
            ROOT::MessageArea::MessageWindow::FadeActor.reset();

            DialogUtil::openConfirmDialog(context, DialogUtil::ERROR, context.translate(ROOT, "MESSAGE_NO_NEED_TO_CHANGE_OIL"));
            return;
        }

        {
            var is_rigid_gear = false;
            var gear_info = ROOT::sRidingCar.getSettingInfoGear();
            is_rigid_gear = gear_info.geartype == main::gtengine::GearType::RIGID;
            var is_racing_kart = gtengine::MSpecDB::checkGenericFlag("is_racing_kart", sRidingCar.getCarCode());

            if (is_rigid_gear || is_racing_kart)
            {
                main::sound.play("disable");
                ROOT::MessageArea::MessageWindow::FadeActor.reset();

                DialogUtil::openConfirmDialog(context, DialogUtil::ERROR, 
                context.translate(ROOT, "MESSAGE_THIS_CAR_CANNOT_CHANGE_OIL"));
                return;
            }
        }

        main::sound.play("ok");

        var menu_icons = ChangeOilMenus;
        if (remain_change_oil_coupon(context) == 0) 
        {
            menu_icons = [];
            foreach (var menu_icon in ChangeOilMenus)
            {
                if (!menu_icon.isInstanceOf(ROOT::CouponIcon))
                    menu_icons.push(menu_icon);
            }
        }

        ROOT::sShopFrontFocus = focus_index;
        ROOT::PP_PS_Change.setup_change_oil(ROOT::sRidingCar);
        ROOT::SceneFaceCover.setVisible("Default");

        {
            var scene;
            var car_code = ROOT::sRidingCar.getCarCode();
            var d_train = gtengine::MSpecDB::getDriveTrainType(car_code);

            switch (d_train)
            {
                case gtengine::DriveTrainType::FF:
                case gtengine::DriveTrainType::FR:
                    scene = "GT_AUTO_oilchange_wait";
                    break;
                case gtengine::DriveTrainType::MR:
                case gtengine::DriveTrainType::RR:
                    scene = "GT_AUTO_oilchange_wait2";
                    break;
                case gtengine::DriveTrainType::_4WD:
                    var engine_mount = gtengine::MSpecDB::getEngineMount(car_code);
                    if (engine_mount == 3)
                        scene = "GT_AUTO_oilchange_wait2";
                    else
                        scene = "GT_AUTO_oilchange_wait";
                        
                    break;
            }

            ROOT::SceneFace.startSceneScript(context, scene);
        }

        ROOT::OilGauge.setOilLife(ROOT::sRidingCar.oil_life);
        ROOT::OilGauge.appear(context, false);
        ROOT::MyHome.hide(context, false);
        ROOT::PP_PS_Change.appear(context, false);
        ROOT::Each.appear(context, "ChangeOil", false);
        ROOT::Menus.swapMenuIcons(context, menu_icons);
    }

    function start_change_oil(context, index, icon, coupon_name)
    {
        var have_paid = ROOT::PayMoney(context, ROOT::sWagesList.change_oil, coupon_name);
        if (!have_paid)
            return;

        context.cursor_visible = false;
        context.event_mask = 5;
        context.disableInput();

        ROOT::PP_PS_Change.hide(context, false);
        ROOT::Each.hide(context, false);
        ROOT::Menus.hide(context, false);

        var scene;
        var car_code = ROOT::sRidingCar.getCarCode();
        var d_train = gtengine::MSpecDB::getDriveTrainType(car_code);

        switch (d_train)
        {
            case gtengine::DriveTrainType::FF:
            case gtengine::DriveTrainType::FR:
                scene = "GT_AUTO_oilchange";
                break;
            case gtengine::DriveTrainType::MR:
            case gtengine::DriveTrainType::RR:
                scene = "GT_AUTO_oilchange2";
                break;
            case gtengine::DriveTrainType::_4WD:
                var engine_mount = gtengine::MSpecDB::getEngineMount(car_code);
                if (engine_mount == 3)
                    scene = "GT_AUTO_oilchange2";
                else
                    scene = "GT_AUTO_oilchange";

                break;
        }

        var oil_anim_start = function (context)
        {
            context.addTimeOut("change_oil_gauge", ROOT::OilGauge.startChangeOilAnimation);
            context.setTimeOut("change_oil_gauge", 4.5);
        };

        var scene_settings = ROOT::SceneFace::SceneSettings(end_change_oil, nil, oil_anim_start, nil, nil, "sound_gt/gt5/gtauto/gtauto_oil");

        ROOT::SceneFace.startSceneScript(context, scene, scene_settings);
    }

    function start_change_oil_free(context, index, icon)
    {
        main::sound.play("ok");
        start_change_oil(context, index, icon, "oil_change_ticket");
    }

    function end_change_oil(context)
    {
        ROOT::OilGauge.hide(context, false);
        ROOT::sRidingCar.setReplaceOil();
        ROOT::UpdateRidingCar();
        
        ROOT::Menus.setMenuIcons(context, BackMenus);
        Menus.appear(context, false);
        context.removeTimeOut("change_oil_gauge");
        context.event_mask = 5;
        context.enableInput();
        context.cursor_visible = true;
    }

    function remain_change_oil_coupon(context)
    {
        return GameItemUtil::ItemBox::getNumByCode("oil_change_ticket");
    }

    static sPaintItem;

    function on_paint_body(context, focus_index)
    {
        var can_all_paint = gtengine::MSpecDB::checkGenericFlag("can_all_paint", sRidingCar.getCarCode());
        if (!can_all_paint)
        {
            main::sound.play("disable");
            ROOT::MessageArea::MessageWindow::FadeActor.reset();

            DialogUtil::openConfirmDialog(context, DialogUtil::ERROR, context.translate(ROOT, "MESSAGE_THIS_CAR_CANNOT_BODY_PAINT"));
            return;
        }

        var paint_item_count = GameItemUtil::ItemBox::getNumByCategory(gtengine::GameItemCategory::PAINT_ITEM);
        if (paint_item_count == 0)
        {
            main::sound.play("disable");
            ROOT::MessageArea::MessageWindow::FadeActor.reset();

            DialogUtil::openConfirmDialog(context, DialogUtil::ERROR, context.translate(ROOT, "MESSAGE_DONOT_HAVE_PAINT_ITEM"));
            return;
        }

        main::sound.play("ok");
        ROOT::sShopFrontFocus = focus_index;

        ROOT::SceneFace.execCommand("setCarVariation 0 bodycolor");
        ROOT::SceneFace.execCommand("swapCarExtraColor -1 -1 -1 -1 bodycolor");

        var hbox = ROOT::Each::PaintBody::PaintColor::HBox;
        hbox.ColorTip::ColorChipFace.setCarColor("car_color_sample", 0);
        hbox.color_name.text = context.translate(ROOT, "UNSETTING_PAINT_COLOR");

        ROOT::SceneFaceCover.setVisible("Default");
        ROOT::SceneFace.startSceneScript(context, "GT_AUTO_bodypaint_preview");
        ROOT::MyHome.hide(context, false);
        ROOT::Each.appear(context, "PaintBody", false);
        ROOT::Menus.swapMenuIcons(context, PaintBodyMenus);
    }

    function select_body_color(context)
    {
        main::sound.play("ok");
        ROOT::Menus.hide(context, false);
        var results = ItemPopup.open(context);

        if (results != nil)
        {
            var paint_item = results;
            var color_id = paint_item.argument1;
            var color_name = paint_item.item_name;

            ROOT::SceneFace.execCommand("swapCarExtraColor %{color_id} -1 -1 -1 bodycolor");

            var hbox = ROOT::Each::PaintBody::PaintColor::HBox;
            hbox.ColorTip::ColorChipFace.setPaintColor(color_id);
            hbox.color_name.text = color_name;

            ROOT::sPaintItem = paint_item;
            ROOT::Menus.swapMenuIcons(context, PaintBodyMenus2, 1);
        }
        else
            ROOT::Menus.appear(context, false);
    }

    function start_paint_body(context, index, icon)
    {
        if (sPaintItem == nil)
            return;

        var color_id = sPaintItem.argument1;
        var color_name = sPaintItem.item_name;

        main::sound.play("ok");
        var accept = DialogUtil::openConfirmDialog(context, DialogUtil::YESNO, context.translate(ROOT, "MESSAGE_DO_YOU_TRY_BODY_PAINT").build(color_name));
        if (!accept)
            return;

        var have_paid = ROOT::PayMoney(context, ROOT::sWagesList.paint_body);
        if (!have_paid)
            return;

        context.cursor_visible = false;
        context.event_mask = 5;
        context.disableInput();
        ROOT::Each.hide(context, false);
        ROOT::Menus.hide(context, false);

        if (gtengine::MSpecDB::getPaintColorType(color_id) == 3)
        {
            var cobj = gtengine::MSpecDB::getPaintColorRGB(color_id, 0);
            var cobj2 = gtengine::MSpecDB::getPaintColorRGB(color_id, 1);
            ROOT::SceneFace.execCommand("setColorPalette 0 %{cobj.r} %{cobj.g} %{cobj.b} %{cobj2.r} %{cobj2.g} %{cobj2.b}");
        }
        else
        {
            var cobj = gtengine::MSpecDB::getPaintColorRGB(color_id, 0);
            ROOT::SceneFace.execCommand("setColorPalette 0 %{cobj.r} %{cobj.g} %{cobj.b}")
        }

        ROOT::SceneFace.execCommand("setCarVariationExtra 0 car2");
        ROOT::SceneFace.execCommand("swapCarExtraColor %{color_id} -1 -1 -1 car2");

        ROOT::SceneFace.setSceneDriver(0);
        ROOT::SceneFace.setSceneDriver(1);
        var scene_settings = ROOT::SceneFace::SceneSettings(end_paint_body, 
        nil, nil, nil, nil, "sound_gt/gt5/gtauto/gtauto_paint");
        ROOT::SceneFace.startSceneScript(context, "GT_AUTO_bodypaint", scene_settings);
    }

    function end_paint_body(context)
    {
        var color_id = sPaintItem.argument1;
        var color_name = sPaintItem.item_name;
        ROOT::SceneFace.execCommand("setCarVariationExtra 0 car1");
        ROOT::SceneFace.execCommand("swapCarExtraColor %{color_id} -1 -1 -1 car1");

        ROOT::sRidingCar.setPaintColor(0, color_id);
        ROOT::sRidingCar.rainX = 0.0;
        ROOT::sRidingCar.dirtiness = 0.0;
        ROOT::UpdateRidingCar();
        GameItemUtil::ItemBox::delete2(ROOT::sPaintItem);

        ROOT::sPaintItem = nil;
        ROOT::sNeedCapture = true;
        ROOT::sNeedCleanDirtiness = true;

        ROOT::Menus.setMenuIcons(context, BackMenus);
        ROOT::Menus.appear(context, false);
        context.event_mask = 5;
        context.enableInput();
        context.cursor_visible = true;
    }

