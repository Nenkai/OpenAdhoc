module ROOT
{
    #include "StoreBase.ad"

    function initCodeMap()
    {
        setMap(
        [
            // widget name     item
            ["Comfort01Text",  "tire_b_01"], 
            ["Comfort02Text",  "tire_b_02"], 
            ["Comfort03Text",  "tire_b_03"], 
            ["Sport01Text",    "tire_b_04"], 
            ["Sport02Text",    "tire_b_05"], 
            ["Sport03Text",    "tire_b_06"], 
            ["Racing01Text",   "tire_b_08"], 
            ["Racing02Text",   "tire_b_09"], 
            ["Racing03Text",   "tire_b_10"], 
        ]);
    }

    function initPriceText()
    {
        CComfort::Comfort01CrText.text = ROOT::getPriceText(ROOT::code_map_.find("Comfort01Text")[1]);
        CComfort::Comfort02CrText.text = ROOT::getPriceText(ROOT::code_map_.find("Comfort02Text")[1]);
        CComfort::Comfort03CrText.text = ROOT::getPriceText(ROOT::code_map_.find("Comfort03Text")[1]);
        CSport::Sport01CrText.text = ROOT::getPriceText(ROOT::code_map_.find("Sport01Text")[1]);
        CSport::Sport02CrText.text = ROOT::getPriceText(ROOT::code_map_.find("Sport02Text")[1]);
        CSport::Sport03CrText.text = ROOT::getPriceText(ROOT::code_map_.find("Sport03Text")[1]);
        CRacing::Racing01CrText.text = ROOT::getPriceText(ROOT::code_map_.find("Racing01Text")[1]);
        CRacing::Racing02CrText.text = ROOT::getPriceText(ROOT::code_map_.find("Racing02Text")[1]);
        CRacing::Racing03CrText.text = ROOT::getPriceText(ROOT::code_map_.find("Racing03Text")[1]);
    }

    function initFocus()
    {
        ROOT.setFocus(CComfort::Comfort01Text);
    }

    function capture()
    {

    }

    module ROOT::CComfort
    {
        method onActivate(context, event)
        {
            return openPurchasingPopup(context, event);
        }

        method onFocusEnter(context, event)
        {
            getItemCount(event.widget);

            return EVENTRESULT_CONTINUE;
        }

        method onFocusLeave(context, event)
        {
            ROOT::Count2::Count::haveCountText.text = 0;

            return EVENTRESULT_CONTINUE;
        }
    }

    module ROOT::CSport
    {
        method onActivate(context, event)
        {
            return openPurchasingPopup(context, event);
        }

        method onFocusEnter(context, event)
        {
            getItemCount(event.widget);

            return EVENTRESULT_CONTINUE;
        }

        method onFocusLeave(context, event)
        {
            ROOT::Count2::Count::haveCountText.text = 0;

            return EVENTRESULT_CONTINUE;
        }
    }

    module ROOT::CRacing
    {
        method onActivate(context, event)
        {
            return openPurchasingPopup(context, event);
        }

        method onFocusEnter(context, event)
        {
            getItemCount(event.widget);

            return EVENTRESULT_CONTINUE;
        }

        method onFocusLeave(context, event)
        {
            ROOT::Count2::Count::haveCountText.text = 0;

            return EVENTRESULT_CONTINUE;
        }
    }
}