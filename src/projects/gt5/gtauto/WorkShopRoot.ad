    function on_change_wheels(context, focus_index)
    {
        var current_wheel = ROOT::sRidingCar.wheel;
        var current_wheel_color = ROOT::sRidingCar.wheel_color;
        var wheel_list = gtengine::MSpecDB::getWheelShopList(ROOT::sRidingCar.getCarCode());
        var wheel_icons = Array();
        var focus_wheel_index = 0;

        for (var i = 0; i < wheel_list.size; i++)
        {
            |var wheel, var wheel_color, var thumbnail| = wheel_list[i];
            var image;
            var caption;
            var unk_local; // NOTE: Unused local

            if (current_wheel == wheel && current_wheel_color == wheel_color)
                continue;

            if (wheel > 0)
            {
                image = "%03d_%02d".format(thumbnail, wheel_color);
                caption = "%03d".format(thumbnail);
            }
            else
            {
                image = "icon_wheel_revert";
                caption = "REVERT_DEFAULT_WHEELS";
            }

            var wheel_icon = WheelIcon(wheel, wheel_color, image, caption, 
                ROOT::start_change_wheels, ROOT::cancel_change_wheels, ROOT::focus_icon_change_wheels);

            wheel_icons.push(wheel_icon);
        }

        if (wheel_icons.size == 0)
        {
            main::sound.play("disable");
            ROOT::MessageArea::MessageWindow::FadeActor.reset();

            DialogUtil::openConfirmDialog(context, DialogUtil::ERROR, context.translate(ROOT, "MESSAGE_THIS_CAR_DOESNOT_HAVE_SAME_WHEELS"));

            return;
        }

        main::sound.play("ok");

        ROOT::sShopFrontFocus = focus_index;

        var scene_settings = ROOT::SceneFace::SceneSettings();
        scene_settings.set_fadeout_end_func(load_wheel_preview_car, wheel_icons[0]);

        ROOT::SceneFaceCover.setVisible("Default");
        ROOT::SceneFace.startSceneScript(context, "GT_AUTO_wheel_preview", scene_settings);
        ROOT::MyHome.hide(context, false);
        ROOT::Each.appear(context, "ChangeWheels", false);
        ROOT::Menus.swapMenuIcons(context, wheel_icons, focus_wheel_index);
    }

    function load_wheel_preview_car(context, args)
    {
        var wheel_icon = args;
        var preview_car = gtengine::MCarParameter();
        preview_car.deepCopy(sRidingCar);
        preview_car.dirtiness = 0.0;
        preview_car.setWheelPaintColor(0, -1);
        preview_car.wheel = wheel_icon.wheel_;
        preview_car.wheel_color = wheel_icon.wheel_color_;
        ROOT::SceneFace.changeCar(preview_car, 0);
    }

    function focus_icon_change_wheels(context, index, wheel_icon)
    {
        context.addTimeOut("change_wheels", ROOT::change_wheels, context, wheel_icon);
        context.setTimeOut("change_wheels", 0.1);
    }

    function change_wheels(context, wheel_icon)
    {
        ROOT::SceneFace.changeWheels(wheel_icon.wheel_, wheel_icon.wheel_color_, 0);
    }

    function cancel_change_wheels(context, index, wheel_icon)
    {
        context.removeTimeOut("change_wheels");
        ROOT::sNeedChangeCar1 = true;
        ROOT::go_shop_front(context);
    }

    function start_change_wheels(context, index, wheel_icon)
    {
        main::sound.play("ok");

        var message = wheel_icon.is_revert_icon_ ? "MESSAGE_WANT_TO_REVERT_DEFAULT_WHEELS" : "MESSAGE_WANT_TO_CHANGE_THIS_WHEELS";
        var accept = DialogUtil::openConfirmDialog(context, DialogUtil::YESNO, context.translate(ROOT, message));
        if (!accept)
            return;

        var have_paid = ROOT::PayMoney(context, ROOT::sWagesList.change_wheels);
        if (!have_paid)
            return;

        ROOT::sRidingCar.setWheelPaintColor(0, -1);
        ROOT::sRidingCar.wheel = wheel_icon.wheel_;
        ROOT::sRidingCar.wheel_color = wheel_icon.wheel_color_;
        ROOT::sRidingCar.rainX = 0.0;
        ROOT::sRidingCar.dirtiness = 0.0;
        ROOT::UpdateRidingCar();

        ROOT::sNeedCapture = true;
        ROOT::sNeedChangeCar1 = true;
        ROOT::sNeedChangeCar2 = true;
        ROOT::sNeedCleanDirtiness = true;

        context.removeTimeOut("change_wheels");
        ROOT::go_shop_front(context);
    }

    static sOnAeroPartsMenu = false;

    function on_aero_parts(context, focus_index)
    {
        var success = ROOT::Each::AeroParts::PartsSelect.setup(context, ROOT::sRidingCar);
        if (!success)
        {
            main::sound.play("disable");
            ROOT::MessageArea::MessageWindow::FadeActor.reset();

            DialogUtil::openConfirmDialog(context, DialogUtil::ERROR, context.translate(ROOT, "MESSAGE_THIS_CAR_DOESNOT_HAVE_AERO_PARTS"));

            return;
        }

        main::sound.play("ok");
        ROOT::sShopFrontFocus = focus_index;
        ROOT::sOnAeroPartsMenu = true;
        ROOT::PP_PS_Change.setup_aero_parts(sRidingCar, []);

        var scene_settings = ROOT::SceneFace::SceneSettings();
        scene_settings.set_fadeout_end_func(load_aero_parts_preview_car);
        ROOT::SceneFaceCover.setVisible("Default");
        ROOT::SceneFace.startSceneScript(context, "GT_AUTO_aero_preview", scene_settings);

        ROOT::MyHome.hide(context, false);
        ROOT::PP_PS_Change.appear(context, false);
        ROOT::Each.appear(context, "AeroParts", false);
        ROOT::Menus.swapMenuIcons(context, AeroPartsMenus);

        ButtonHelpGT5.set(context, [
            [ButtonHelpGT5.getEnterButtonName(), context.translate(ROOT, "Component", "Enter")], 
            ["Triangle", context.translate(ROOT, "CHANGE_CAMERA_ANGLE")], 
            [ButtonHelpGT5.getCancelButtonName(), context.translate(ROOT, "Component", "Cancel")]
        ]);
    }

    function load_aero_parts_preview_car(context, args)
    {
        var preview_car = gtengine::MCarParameter();
        preview_car.deepCopy(sRidingCar);
        preview_car.dirtiness = 0.0;
        ROOT::SceneFace.changeCar(preview_car, 0);
    }

    function start_aero_parts(context, index, icon)
    {
        |var total_price, var parts_list, var all_normal| = ROOT::Each::AeroParts::PartsSelect.getResult(context);
        if (parts_list.size == 0)
        {
            main::sound.play("disable");
            if (!all_normal)
            {
                DialogUtil::openConfirmDialog(context, DialogUtil::ERROR, 
                context.translate(ROOT, "MESSAGE_NEW_AERO_NOT_SELECTED"));
            }

            return;
        }

        main::sound.play("ok");

        var accept = DialogUtil::openConfirmDialog(context, DialogUtil::YESNO, context.translate(ROOT, "MESSAGE_DO_YOU_TRY_NEW_AERO"));
        if (!accept)
            return;

        var have_paid = ROOT::PayMoney(context, total_price);
        if (!have_paid)
            return;

        ROOT::sRidingCar.beginPartsInfo();

        foreach (var parts in parts_list)
        {
            |var parts_type_index, var parts_index| = parts;
            ROOT::sRidingCar.setParts(parts_type_index, parts_index);
        }

        ROOT::sRidingCar.endPartsInfo();
        ROOT::sRidingCar.rainX = 0.0;
        ROOT::sRidingCar.dirtiness = 0.0;
        ROOT::UpdateRidingCar();

        ROOT::sNeedCapture = true;
        ROOT::sNeedChangeCar1 = true;
        ROOT::sNeedChangeCar2 = true;
        ROOT::sNeedCleanDirtiness = true;
        ROOT::go_shop_front(context);
    }

    function cancel_aero_parts(context)
    {
        ROOT::sNeedChangeCar1 = true;
        SceneFaceUtil::loadScene(ROOT::SceneFace, "GT_AUTO_aero_preview3");
        go_shop_front(context);
    }

    function return_aero_parts(context)
    {
        main::sound.play("ok");
        cancel_aero_parts(context);
    }

    function on_key_press_aero_parts(context)
    {
        SceneFaceUtil::loadScene(ROOT::SceneFace, "GT_AUTO_aero_preview2");
    }

    function on_key_release_aero_parts(context)
    {
        SceneFaceUtil::loadScene(ROOT::SceneFace, "GT_AUTO_aero_preview3");
    }

    function on_engine_overhaul(context, focus_index)
    {
        if (ROOT::sRidingCar.engine_life <= 0.0)
        {
            main::sound.play("disable");
            ROOT::MessageArea::MessageWindow::FadeActor.reset();

            DialogUtil::openConfirmDialog(context, DialogUtil::ERROR, context.translate(ROOT, "MESSAGE_NO_NEED_TO_ENGINE_OVERHAUL"));

            return;
        }

        main::sound.play("ok");

        var menu_icons = EngineOverhaulMenus;
        if (remain_engine_overhaul_coupon(context) == 0)
        {
            menu_icons = [];
            foreach (var menu_icon in EngineOverhaulMenus)
            {
                if (!menu_icon.isInstanceOf(ROOT::CouponIcon))
                    menu_icons.push(menu_icon);
            }
        }

        ROOT::sShopFrontFocus = focus_index;
        ROOT::PP_PS_Change.setup_engine_overhaul(ROOT::sRidingCar);

        ROOT::SceneFaceCover.setVisible("EngineOverhaul");
        ROOT::SceneFaceCover.appear(context, false);
        ROOT::MyHome.hide(context, false);
        ROOT::PP_PS_Change.appear(context, false);
        ROOT::Each.appear(context, "EngineOverhaul", false);
        ROOT::Menus.swapMenuIcons(context, menu_icons);
    }

    function start_engine_overhaul(context, index, icon, coupon_name)
    {
        var have_paid = ROOT::PayMoney(context, ROOT::sWagesList.engine_overhaul, coupon_name);
        if (!have_paid)
            return;

        context.cursor_visible = false;
        context.event_mask = 5;
        context.disableInput();

        ROOT::PP_PS_Change.hide(context, false);
        ROOT::Each.hide(context, false);
        ROOT::Menus.hide(context, false);
        ROOT::SceneFace.setSceneDriver(0);
        ROOT::SceneFace.setSceneDriver(1);

        var scene_settings = ROOT::SceneFace::SceneSettings(end_engine_overhaul, nil, nil, nil, nil, "sound_gt/gt5/gtauto/gtauto_body_engine");
        ROOT::SceneFace.startSceneScript(context, "GT_AUTO_garage", scene_settings);
    }

    function start_engine_overhaul_free(context, index, icon)
    {
        main::sound.play("ok");
        start_engine_overhaul(context, index, icon, "overhaul_ticket");
    }

    function work_engine_overhaul(cp)
    {
        cp.engine_life = 0.0;
        cp.setReplaceOil();
        cp.rainX = 0.0;
        cp.dirtiness = 0.0;
    }

    function end_engine_overhaul(context)
    {
        work_engine_overhaul(ROOT::sRidingCar);
        ROOT::UpdateRidingCar();
        ROOT::sNeedChangeCar1 = true;

        ROOT::SceneFaceCover.setVisible("Default");
        ROOT::Menus.setMenuIcons(context, BackMenus);
        ROOT::Menus.appear(context, false);
        context.event_mask = 5;
        context.enableInput();
        context.cursor_visible = true;
    }

    function remain_engine_overhaul_coupon(context)
    {
        return GameItemUtil::ItemBox::getNumByCode("overhaul_ticket");
    }

