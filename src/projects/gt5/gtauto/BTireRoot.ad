module ROOT
{
    #include "StoreBase.ad"

    function initCodeMap()
    {
        setMap([
            ["c_hard", "tire_a_01"], 
            ["c_medium", "tire_a_02"], 
            ["c_soft", "tire_a_03"], 
            ["s_hard", "tire_a_04"], 
            ["s_medium", "tire_a_05"], 
            ["s_soft", "tire_a_06"], 
            ["r_hard", "tire_a_08"], 
            ["r_medium", "tire_a_09"], 
            ["r_soft", "tire_a_10"], 
            ["dirt_tire", "tire___14"], 
            ["snow_tire", "tire___15"]
        ]);
    }

    function initPriceText()
    {
        BComfort::c_hard::Cr::CrText.text = getPriceText(code_map_.find("c_hard")[1]);
        BComfort::c_medium::Cr::CrText.text = getPriceText(code_map_.find("c_medium")[1]);
        BComfort::c_soft::Cr::CrText.text = getPriceText(code_map_.find("c_soft")[1]);
        BSport::s_hard::Cr::CrText.text = getPriceText(code_map_.find("s_hard")[1]);
        BSport::s_medium::Cr::CrText.text = getPriceText(code_map_.find("s_medium")[1]);
        BSport::s_soft::Cr::CrText.text = getPriceText(code_map_.find("s_soft")[1]);
        BRacing::r_hard::Cr::CrText.text = getPriceText(code_map_.find("r_hard")[1]);
        BRacing::r_medium::Cr::CrText.text = getPriceText(code_map_.find("r_medium")[1]);
        BRacing::r_soft::Cr::CrText.text = getPriceText(code_map_.find("r_soft")[1]);
        dirt_tire::info::Cr::CrText.text = getPriceText(code_map_.find("dirt_tire")[1]);
        snow_tire::info::Cr::CrText.text = getPriceText(code_map_.find("snow_tire")[1]);

        checkPartsStatus(BComfort::c_hard);
        checkPartsStatus(BComfort::c_medium);
        checkPartsStatus(BComfort::c_soft);
        checkPartsStatus(BSport::s_hard);
        checkPartsStatus(BSport::s_medium);
        checkPartsStatus(BSport::s_soft);
        checkPartsStatus(BRacing::r_hard);
        checkPartsStatus(BRacing::r_medium);
        checkPartsStatus(BRacing::r_soft);
        checkPartsStatus(dirt_tire);
        checkPartsStatus(snow_tire);
    }

    function initFocus()
    {
        ROOT.setFocus(BComfort::c_hard);
    }

    function capture()
    {

    }

    module ROOT::BComfort
    {
        method onActivate(context, event)
        {
            return openPurchasingPopup(context, event);
        }

        method onFocusEnter(context, event)
        {
            getItemCount(event.widget);
            ROOT::Count2::Count::haveCountText::FadeActor.start();

            return EVENTRESULT_CONTINUE;
        }

        method onFocusLeave(context, event)
        {
            ROOT::Count2::Count::haveCountText::FadeActor.reset();
            ROOT::Count2::Count::haveCountText.text = "";

            return EVENTRESULT_CONTINUE;
        }
    }

