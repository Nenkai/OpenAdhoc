module ROOT
{
    #include "StoreBase.ad"

    function initCodeMap()
    {
        setMap([
            ["Stage1Text", "nos_01"], 
            ["Stage2Text", "nos_02"], 
            ["Stage3Text", "nos_03"],
            ["Stage11Text", "special_gasoline_01"], 
            ["Stage12Text", "special_gasoline_02"], 
            ["Stage13Text", "special_gasoline_03"], 
            ["Stage21Text", "horn_01"]
        ]);
    }

    function initPriceText()
    {
        Nos::Stage1CrText.text = ROOT::getPriceText(ROOT::code_map_.find("Stage1Text")[1]);
        Nos::Stage2CrText.text = ROOT::getPriceText(ROOT::code_map_.find("Stage2Text")[1]);
        Nos::Stage3CrText.text = ROOT::getPriceText(ROOT::code_map_.find("Stage3Text")[1]);
        SpecialGas::Stage1CrText.text = ROOT::getPriceText(ROOT::code_map_.find("Stage11Text")[1]);
        SpecialGas::Stage2CrText.text = ROOT::getPriceText(ROOT::code_map_.find("Stage11Text")[1]); //BUG: Stage11Text twice
        SpecialGas::Stage3CrText.text = ROOT::getPriceText(ROOT::code_map_.find("Stage13Text")[1]);
        Horn::Stage1CrText.text = ROOT::getPriceText(ROOT::code_map_.find("Stage21Text")[1]);
    }

    function initFocus()
    {
        ROOT.setFocus(Nos::Stage1Text);
    }

    function capture()
    {

    }

    module ROOT::Nos
    {
        method onActivate(context, event)
        {
            return openPurchasingPopup(context, event);
        }
    }

    module ROOT::SpecialGas
    {
        method onActivate(context, event)
        {
            return openPurchasingPopup(context, event);
        }

        method onFocusEnter(context, event)
        {
            getItemCount(event.widget);

            return EVENTRESULT_CONTINUE;
        }

        method onFocusLeave(context, event)
        {
            ROOT::Count2::Count::haveCountText.text = 0;

            return EVENTRESULT_CONTINUE;
        }
    }

    module ROOT::Horn
    {
        method onActivate(context, event)
        {
            return openPurchasingPopup(context, event);
        }

        method onFocusEnter(context, event)
        {
            getItemCount(event.widget);

            return EVENTRESULT_CONTINUE;
        }

        method onFocusLeave(context, event)
        {
            ROOT::Count2::Count::haveCountText.text = 0;

            return EVENTRESULT_CONTINUE;
        }
    }
}