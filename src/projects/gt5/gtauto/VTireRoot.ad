module ROOT
{
    #include "StoreBase.ad"

    function initCodeMap()
    {
        setMap(
        [
            // widget name    item
            ["Comfort01Text", "tire_c_01"], 
            ["Comfort02Text", "tire_c_02"], 
            ["Comfort03Text", "tire_c_03"], 
            ["Sport01Text",   "tire_c_04"], 
            ["Sport02Text",   "tire_c_05"], 
            ["Sport03Text",   "tire_c_06"], 
            ["Racing01Text",  "tire_c_08"], 
            ["Racing02Text",  "tire_c_09"], 
            ["Racing03Text",  "tire_c_10"], 
        ]);
    }

    function initPriceText()
    {
        VComfort::Comfort01CrText.text = ROOT::getPriceText(ROOT::code_map_.find("Comfort01Text")[1]);
        VComfort::Comfort02CrText.text = ROOT::getPriceText(ROOT::code_map_.find("Comfort02Text")[1]);
        VComfort::Comfort03CrText.text = ROOT::getPriceText(ROOT::code_map_.find("Comfort03Text")[1]);
        VSport::Sport01CrText.text = ROOT::getPriceText(ROOT::code_map_.find("Sport01Text")[1]);
        VSport::Sport02CrText.text = ROOT::getPriceText(ROOT::code_map_.find("Sport02Text")[1]);
        VSport::Sport03CrText.text = ROOT::getPriceText(ROOT::code_map_.find("Sport03Text")[1]);
        VRacing::Racing01CrText.text = ROOT::getPriceText(ROOT::code_map_.find("Racing01Text")[1]);
        VRacing::Racing02CrText.text = ROOT::getPriceText(ROOT::code_map_.find("Racing02Text")[1]);
        VRacing::Racing03CrText.text = ROOT::getPriceText(ROOT::code_map_.find("Racing03Text")[1]);
    }

    function initFocus()
    {
        ROOT.setFocus(VComfort::Comfort01Text);
    }

    function capture()
    {

    }

    module ROOT::VComfort
    {
        method onActivate(context, event)
        {
            return openPurchasingPopup(context, event);
        }

        method onFocusEnter(context, event)
        {
            getItemCount(event.widget);

            return EVENTRESULT_CONTINUE;
        }

        method onFocusLeave(context, event)
        {
            ROOT::Count2::Count::haveCountText.text = 0;

            return EVENTRESULT_CONTINUE;
        }
    }

    module ROOT::VSport
    {
        method onActivate(context, event)
        {
            return openPurchasingPopup(context, event);
        }

        method onFocusEnter(context, event)
        {
            getItemCount(event.widget);

            return EVENTRESULT_CONTINUE;
        }

        method onFocusLeave(context, event)
        {
            ROOT::Count2::Count::haveCountText.text = 0;

            return EVENTRESULT_CONTINUE;
        }
    }

    module ROOT::VRacing
    {
        method onActivate(context, event)
        {
            return openPurchasingPopup(context, event);
        }

        method onFocusEnter(context, event)
        {
            getItemCount(event.widget);

            return EVENTRESULT_CONTINUE;
        }

        method onFocusLeave(context, event)
        {
            ROOT::Count2::Count::haveCountText.text = 0;

            return EVENTRESULT_CONTINUE;
        }
    }
}