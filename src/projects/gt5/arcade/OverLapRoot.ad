module ROOT
{
    method onRaceModeSelect(context)
    {
        SplitLine.visible = false;
        ROOT.setTopicPath("RaceModeSelect");
        ROOT::ButtonHelpGT5.set(context, [
            [ButtonHelpGT5.getEnterButtonName(), context.translate(ROOT, "BUTTON_OK")], 
            [ButtonHelpGT5.getCancelButtonName(), context.translate(ROOT, "BUTTON_BACK")]
        ]);
    }

    method onCourseSelect(context)
    {
        SplitLine.visible = false;
        ROOT.setTopicPath("CourseSelect");
        ROOT::ButtonHelpGT5.set(context, [
            [ButtonHelpGT5.getEnterButtonName(), context.translate(ROOT, "BUTTON_OK")], 
            [ButtonHelpGT5.getCancelButtonName(), context.translate(ROOT, "BUTTON_BACK")]
        ]);
    }

    method onCarSelect(context)
    {
        SplitLine.visible = false;
        ROOT.setTopicPath("CarSelect");
        ROOT::ButtonHelpGT5.set(context, [
            [ButtonHelpGT5.getEnterButtonName(), context.translate(ROOT, "BUTTON_OK")], 
            
            ["Triangle", context.translate(ROOT, "BUTTON_SPEEDUP_CAR_ROTATE")], 
            [ButtonHelpGT5.getCancelButtonName(), context.translate(ROOT, "BUTTON_BACK")]
        ]);
    }

    method onDrivingOption(context)
    {
        SplitLine.visible = false;
        ROOT.setTopicPath("Option");
    }

    method onEasyModeOption(context)
    {
        SplitLine.visible = false;
        ROOT.setTopicPath("Option");
        ROOT::ButtonHelpGT5.set(context, [
            [ButtonHelpGT5.getEnterButtonName(), context.translate(ROOT, "BUTTON_OK")], 
            [ButtonHelpGT5.getCancelButtonName(), context.translate(ROOT, "BUTTON_BACK")]
        ]);
    }

    method onSplitCarSelect(context)
    {
        SplitLine.visible = true;
        ROOT.setTopicPath("CarSelect");
        
        ROOT::ButtonHelpGT5.hide();
    }

    method setTopicPath(topic)
    {
        for (var it = TopicPath.first; it != nil; it = it.next_widget)
            it.active = false;

        TopicPath[topic].active = true;
    }
}