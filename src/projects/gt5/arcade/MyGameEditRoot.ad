module ROOT
{
    method open(context, from_prev_page)
    {
        if (from_prev_page)
            SequenceUtil::startXEffectTransitionIn(context, ROOT);
        else
            SequenceUtil::startXEffectTransitionOut(context, ROOT);
    }

    method close(context)
    {
        gArcadeSequence.movePrevPage(context);
    }

    method onCancel(context)
    {
        close(context);
        return EVENTRESULT_FILTER;
    }
}