            method __init__(cc, cl, ct, w, wv0, ir, wa, t, tps, ba, cps, is, ms, st, ns, cd, cp)
            {
                self.course_code = cc;
                self.course_label = cl;
                self.course_types = ct;
                self.weathers = w;
                self.weather_value0s = wv0;
                self.initial_retentions = ir;
                self.weather_accels = wa;
                self.times = t;
                self.time_progress_speeds = tps;
                self.bank_angularitys = ba;
                self.car_parameters = cps;
                self.initial_seeds = is;
                self.missing_seeds = ms;
                self.seed_type = st;
                self.num_seed = ns;
                self.course_data = cd;
                self.course_pathway = cp;
            }
        }

        function getCourseLabelList()
        {
            var list = [];

            if (GetVersionBranch() == "gt5")
            {
                list = ["template06", "template05", "template07", "template01", "template08", "template10", "template11"];
            }
            else
            {
                foreach (|var course_label, var params| in ThemeParams::theme_list)
                    list.push(course_label);
            }

            return list;
        }

        function getParams(course_label)
        {
            var params = ThemeParams::theme_list[course_label];
            if (params == nil)
                return nil;

            var course_code = gtengine::MSpecDB::getCourseCode(course_label);
            var target = 0;

            var course_types = [ThemeParams::course_type_circuit, ThemeParams::course_type_rally];
            if (params.size >= target + 1 && params[target] != nil)
                course_types = params[target];
            ++target;

            var weathers = [ThemeParams::weather_sunny, ThemeParams::weather_rainy, ThemeParams::weather_snowy];
            if (params.size >= target + 1 && params[target] != nil && params[target].size > 0)
                weathers = params[target];
            ++target;

            var weather_value0s = [1.0, -1.0, 1.0];
            if (params.size >= target + 1 && params[target] != nil && params[target].size > 0)
                weather_value0s = params[target];
            ++target;

            var initial_retentions = [0, 10, 0];
            if (params.size >= target + 1 && params[target] != nil && params[target].size > 0)
                initial_retentions = params[target];
            ++target;

            var weather_accels = [0, 1000, 0];
            if (params.size >= target + 1 && params[target] != nil && params[target].size > 0)
                weather_accels = params[target];
            ++target;

            var times_tmp = ["0:00", "23:00", "12:00"];
            if (params.size >= target + 1 && params[target] != nil && params[target].size > 0)
                times_tmp = params[target];

            var times = [];
            foreach (var time_str in times_tmp)
                times.push(get_time_second(time_str));
            ++target;

            var time_progress_speeds = [1.0, 60.0, 1.0];
            if (params.size >= target + 1 && params[target] != nil && params[target].size > 0)
                time_progress_speeds = params[target];
            ++target;

            var bank_angularitys = [0, 10, 0];
            if (params.size >= target + 1 && params[target] != nil && params[target].size > 0)
                bank_angularitys = params[target];
            ++target;

            var car_parameters = [["impreza_sedan_wrx_sti_10", 0], ["c4_wrc_08", 0]];
            if (params.size >= target + 1 && params[target] != nil)
                car_parameters = params[target];
            ++target;

            var car_parameters_array = [];
            foreach (|var car_label, var car_color| in car_parameters)
            {
                var cp = gtengine::MCarParameter();
                cp.setCarCode(car_label);
                cp.color = car_color;
                car_parameters_array.push(cp);
            }

            var initial_seeds = [0];
            if (params.size >= target + 1 && params[target] != nil)
                initial_seeds = params[target];

            if (GetVersionBranch() == "runviewer" && AppOpt.defined("course_maker_seed"))
                initial_seeds = [AppOpt["course_maker_seed"].toInt()];
            ++target;

            var missing_seeds = [];
            if (params.size >= target + 1 && params[target] != nil)
                missing_seeds = params[target];
            ++target;

            var seed_type = ThemeParams::seed_type_sequence;
            if (params.size >= target + 1 && params[target] != nil)
                seed_type = params[target];
            ++target;

            var num_seed = 100;
            if (params.size >= target + 1 && params[target] != nil)
                num_seed = params[target];

            var course_data = CourseFileUtil::Data();
            var tp = ThemeParams(
                course_code,
                course_label,
                course_types,
                weathers,
                weather_value0s,
                initial_retentions,
                weather_accels,
                times,
                time_progress_speeds,
                bank_angularitys,
                car_parameters_array,
                initial_seeds,
                missing_seeds,
                seed_type,
                num_seed,
                course_data
            );

            return tp;
        }
    }

    function get_time_second(hour_minute_str)
    {
        var hour_minute = hour_minute_str.split(":");
        if (hour_minute == nil || !hour_minute.isInstanceOf(Array) || hour_minute.size != 2)
            return EVENTRESULT_CONTINUE;

        |var hour, var minute| = hour_minute;

        return ((hour.toInt() * 60) * 60) + (minute.toInt() * 60);
    }

    function get_time_array(second)
    {
        var sec = second % 60;
        var s = second / 60;

        var min = s % 60;
        s /= 60;

        var hour = s % 60;

        return [hour, min, sec];
    }

    function open_manual_popup(context)
    {
        var additional_sounds = main::pdiext::MSoundEffect("sound_gt/se/gt5menu.sgd");
        ManualProject::ManualDetailPopup.open(context, ["Coursemaker_01", "Coursemaker_02", "Coursemaker_03"], 0);
        additional_sounds = nil;
    }

    function ignorePadEvent(context, wait)
    {
        if (wait)
        {
            CursorUtil::setCursor(context, "wait");
            disable_input(context);
        }
        else
        {
            CursorUtil::setCursor(context, "cursor_chrome");
            enable_input(context);
        }
    }

    function enable_input(context)
    {
        context.event_mask = 5;
        context.enableInput();
    }

    function disable_input(context)
    {
        context.event_mask = 5;
        context.disableInput();
        context.filterKeyEvent();
    }

    function get_theme_name(context, root, course_label)
    {
        if (course_label == nil)
            return "";

        var text = context.translate(root, "CourseName", course_label);
        if (GetVersionBranch() == "runviewer")
        {
            if (text != course_label)
                text += " [%s]".format(course_label);
        }

        return text;
    }

    function get_theme_image_path(context, course_label)
    {
        if (course_label == nil)
            return "";
        
        var template_num = course_label.substr(course_label.size - 2, course_label.size).toInt();
        
        var file_postfix;
        if (template_num > 11)
            file_postfix = "template11";
        else
            file_postfix = course_label;

        return "piece/course_maker/cm_thumb_%s.img".format(file_postfix);
    }

    function resetActors(widget, reverse, warp)
    {
        for (var current_widget = widget.first_actor; current_widget != nil; current_widget = current_widget.next_actor)
        {
            if (current_widget.isInstanceOf(main::menu::MActor))
            {
                current_widget.stop();
                current_widget.reverse = reverse;

                if (warp)
                    current_widget.reverse = !reverse;

                current_widget.rewind();
                current_widget.start();
            }
        }
    }

    function startActors(widget, reverse)
    {
        for (var current_widget = widget.first_actor; current_widget != nil; current_widget = current_widget.next_actor)
        {
            if (current_widget.isInstanceOf(main::menu::MActor))
            {
                current_widget.stop();
                current_widget.reverse = reverse;
                current_widget.start();
            }
        }
    }

    function warpActors(widget, reverse)
    {
        for (var current_widget = widget.first_actor; current_widget != nil; current_widget = current_widget.next_actor)
        {
            if (current_widget.isInstanceOf(main::menu::MActor))
            {
                current_widget.reverse = reverse;
                current_widget.rewind();
                current_widget.reverse = !reverse;
            }
        }
    }

    function getDateTime(context, root, d)
    {
        var time = main::pdistd::MTime();
        time.setBySecond(d);
        var local_time = time.toLocal();

        return context.translate(root, "DateTime", "FORMAT_DATE_TIME").build(
            local_time.year, "%02d".format(local_time.month), "%02d".format(local_time.day), 
            "%02d".format(local_time.hour), "%02d".format(local_time.minute)
        );
    }
}