module PROJECT
{
    PROJECT.load("/scripts/gt6/util/NPCommerceUtil");
    PROJECT.load("/scripts/gt6/util/USBPSPCommPS3");
    PROJECT.load("/scripts/gt6/util/MuseumUtil");
    PROJECT.load("/scripts/gt6/util/StorageDataUtil");
    PROJECT.load("/scripts/gt6/util/StorageDataUtilGT5");
    PROJECT.load("/scripts/gt6/util/OnlineEventUtil");

    function onLoad(update_context)
    {

        update_context.createRenderContext(1);

        var render_context = update_context.getRenderContext(0);

        SequenceUtil::startPage(render_context, TopRoot);
    }
    
    function onUnload(update_context) 
    {

    }
}