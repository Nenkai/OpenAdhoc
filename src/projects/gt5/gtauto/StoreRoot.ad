module StoreRoot
{
    hidden.visible = false;

    static sCategoryRootData = [
        "BODY_CHASSIS" : ["BodyChassisRoot",  [511]], 
        "ENGINE"       : ["EngineRoot",       [521]], 
        "ADMISSION"    : ["AdmissionRoot",    [531]], 
        "EMISSION"     : ["EmissionRoot",     [532]], 
        "BOOSTER"      : ["BoosterRoot",      [541]], 
        "TRANSMISSION" : ["TransmissionRoot", [551]], 
        "DRIVETRAIN"   : ["DrivetrainRoot",   [556]], 
        "SUSPENSION"   : ["SuspensionRoot",   [561]], 
        "BTIRE"        : ["BTireRoot",        [581, 582, 583, 586]], 
        "CTIRE"        : ["CTireRoot",        [581, 582, 583]], 
        "VTIRE"        : ["VTireRoot",        [581, 582, 583]]
    ];

    method open(context)
    {
        SequenceUtil::startPage(context, self);
    }

    method close(context)
    {
        GTAutoProject.history['StoreRoot::FocusWidgetName'] = "";
        SequenceUtil::startProject(context, "gtmode");
    }

    method onInitialize(context)
    {
        self.insensitive = true;

        ButtonHelpGT5.set(context, [
            [ButtonHelpGT5.getEnterButtonName(), context.translate(StoreRoot, "Component", "Enter")], 
            [ButtonHelpGT5.getCancelButtonName(), context.translate(StoreRoot, "Component", "Cancel")]
        ]);

        var focus_widget_name = GTAutoProject.history['StoreRoot::FocusWidgetName'];
        var focus_widget = focus_widget_name != "" ? StoreRoot.getModuleAttribute(focus_widget_name) : nil;
        GTAutoProject.history['GTModeRoot::FocusWidgetName'] = "";

        StoreRoot.setFocus(focus_widget != nil ? focus_widget : StoreFront::BTIRE);
        context.pushEvent(main::menu::MFunctionEvent(postInitialize, context));
    }

    method postInitialize(context)
    {
        self.insensitive = false;
        SoundUtil::MenuBGMCrossfadeGroup("tuning_shop", 0.0, 3.0);
        self.openModeIntroduction(context);
    }

    method onFinalize(context)
    {

    }

    method openModeIntroduction(context)
    {
        if (!GAME_STATUS.user_profile.game_flags.getFlag("INTRODUCTION", "TUNING_SHOP"))
        {
            context.wait(0.5);
            DialogUtil::openInformationDialog(context, context.translate(StoreRoot, "IntroductionGT5", "TUNING_SHOP"));
            GAME_STATUS.user_profile.game_flags.setFlag("INTRODUCTION", "TUNING_SHOP", true);
        }
    }

    function GetMoneyString(num)
    {
        var str = "";
        if (num == 0)
            str = "Cr.0";
        else
            str = "Cr." + main::pdiext::MMisc::GetMoneyString(num);

        return str;
    }
}

module StoreRoot::ItemList
{
    method onInitialize(context)
    {

    }

    method onFinalize(context)
    {

    }
}

module StoreRoot::StoreFront
{
    method onCancel(context)
    {
        if (GTAutoProject::DIRECT_CANCEL_BACK)
        {
            sound.play("return");
            close(context);
        }
        else
        {
            sound.play("cancel");
            StoreRoot.setFocus(StoreRoot::MyHome);
        }

        return EVENTRESULT_FILTER;
    }
}

module StoreRoot::StoreFront::BODY_CHASSIS
{
    method onActivate(context)
    {
        var data = sCategoryRootData.find("BODY_CHASSIS");
        var root = data[1][0];
        var id_list = data[1][1];

        main::sound.play("ok");
        GTAutoProject.history['StoreRoot::FocusWidgetName'] = self.getNodePath(GTAutoProject::StoreRoot);
        GTAutoProject[root].open(context, id_list);

        return EVENTRESULT_FILTER;
    }
}

